    finished = true;
    dom.modal.hidden = true;
    document.body.style.overflow = '';
    dom.modal.classList.remove('rp-profile-modal', 'em-modal', 'map-modal', 'bibliography-modal', 'author-modal', 'legacy-modal');
  };
  dom.modalPanel.addEventListener('transitionend', finish, { once: true });
  setTimeout(finish, 450);
}

