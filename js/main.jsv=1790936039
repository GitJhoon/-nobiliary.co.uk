// Recomputes how many avatars actually fit in the row — .rp-avatar has a
// fluid width (see CSS), so a fixed count would either overflow on a
// narrow/tablet screen or leave the row looking sparse on a wide one.
function computeRpPageSize() {
  const row = dom.rpAvatars;
  if (!row) return RP_PAGE_SIZE;

  const rowWidth = row.getBoundingClientRect().width;
  if (!rowWidth) return RP_PAGE_SIZE;

  // The grid is always 2 rows; only the column count adapts to the width.
  const gap = parseFloat(getComputedStyle(row).columnGap) || 16;
  const minCardWidth = rowWidth < 600 ? 120 : 150;
  const cols = Math.max(2, Math.min(8, Math.floor((rowWidth + gap) / (minCardWidth + gap))));
  row.style.setProperty('--rp-cols', cols);
  return cols * 2;
}

function updateRpPageSize() {
  const next = computeRpPageSize();
  if (next !== RP_PAGE_SIZE) {
    RP_PAGE_SIZE = next;
    renderRulerAvatars();
  }
}

