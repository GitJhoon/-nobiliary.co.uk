/* ─────────────────────────────────────────
   URL PATH ROUTING — /timeline, /timeline/{slug}, /rulers,
   /rulers/{slug}, /map, /legacy, /bibliography, /about

   Slugs are computed client-side from the same data the server used to
   compute them (see includes/data.php's slugify/event_slug_map — keep
   the two in sync), so a link built by PHP always resolves here, and a
   URL typed by a visitor always resolves to the right ruler/event.
───────────────────────────────────────── */
const PATH_TO_NAV_KEY = {
  timeline:      'overview',
  rulers:        'rulers-dynasties',
  houses:        'houses',
  'at-glance':   'at-glance',
  map:           'map',
  legacy:        'legacy',
  bibliography:  'bibliography',
  about:         'author',
};
const NAV_KEY_TO_PATH = {
  overview:            'timeline',
  'rulers-dynasties':  'rulers',
  houses:              'houses',
  'at-glance':         'at-glance',
  map:                 'map',
  legacy:              'legacy',
  bibliography:        'bibliography',
  author:              'about',
};

// Must produce byte-identical output to PHP's slugify() in includes/data.php.
const SLUGIFY_MAP = {
  'á':'a','à':'a','â':'a','ä':'a','ã':'a','å':'a','ą':'a',
  'é':'e','è':'e','ê':'e','ë':'e','ě':'e','ė':'e','ę':'e',
  'í':'i','ì':'i','î':'i','ï':'i','į':'i',
  'ó':'o','ò':'o','ô':'o','ö':'o','õ':'o','ø':'o',
  'ú':'u','ù':'u','û':'u','ü':'u','ů':'u','ų':'u','ū':'u','ŭ':'u',
  'ý':'y','ÿ':'y',
  'ñ':'n','ń':'n',
  'ç':'c','ć':'c','č':'c',
  'ł':'l',
  'ś':'s','š':'s',
  'ź':'z','ż':'z','ž':'z',
  'æ':'ae','ß':'ss',
};

function slugify(text) {
  const lower = String(text || '').toLowerCase();
  const translit = lower.replace(/[^\x00-\x7f]/g, ch => SLUGIFY_MAP[ch] || ch);
  return translit.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

let rulerSlugByIndex = [];
let rulerIndexBySlug = new Map();
let eventSlugByKey = new Map();  // `${eraIdx}:${eventIdx}` -> slug
let eventBySlug = new Map();     // slug -> { era, eventIndex }

// Built once RULERS/state.eras are loaded (called from init()). Mirrors
// includes/data.php's ruler_slug_map()/event_slug_map() exactly — same
// disambiguation rule (append reign-start year / -2, -3, ... suffix) in
// the same encounter order, so both sides always agree on every slug.
function buildSlugMaps() {
  const baseR = RULERS.map(r => slugify(r.name));
  const countsR = new Map();
  baseR.forEach(s => countsR.set(s, (countsR.get(s) || 0) + 1));
  rulerSlugByIndex = RULERS.map((r, i) => (countsR.get(baseR[i]) > 1 ? `${baseR[i]}-${r.from}` : baseR[i]));
  rulerIndexBySlug = new Map(rulerSlugByIndex.map((s, i) => [s, i]));

  const entries = [];
  state.eras.forEach((era, eraIdx) => {
    if (era.isIntro) return;
    era.events.forEach((event, eventIdx) => entries.push({ eraIdx, eventIdx, year: era.year, title: event.title }));
  });
  const base = entries.map(e => `${e.year}-${slugify(e.title)}`);
  const counts = new Map();
  base.forEach(s => counts.set(s, (counts.get(s) || 0) + 1));
  const seen = new Map();
  eventSlugByKey = new Map();
  eventBySlug = new Map();
  entries.forEach((e, i) => {
    let slug = base[i];
    if (counts.get(slug) > 1) {
      const n = (seen.get(slug) || 0) + 1;
      seen.set(slug, n);
      if (n > 1) slug += '-' + n;
    }
    eventSlugByKey.set(`${e.eraIdx}:${e.eventIdx}`, slug);
    eventBySlug.set(slug, { era: state.eras[e.eraIdx], eventIndex: e.eventIdx });
  });
}

function rulerSlug(ruler) {
  const idx = RULERS.indexOf(ruler);
  return idx >= 0 ? rulerSlugByIndex[idx] : null;
}

function eraEventSlug(era, eventIndex) {
  const eraIdx = state.eras.indexOf(era);
  return eventSlugByKey.get(`${eraIdx}:${eventIndex}`) || null;
}

// Set once by index.php from the same base_path() PHP uses for routing —
// '' at a domain root (production), or e.g. '/gdl-history' when the app is
// served from a subdirectory (local WAMP). Route paths (leading "/") need
// this prefix explicitly; plain-relative asset paths don't (handled by the
// <base href> tag instead).
const BASE_PATH = window.__BASE_PATH__ || '';

function setLocationPath(path, hash = '') {
  const full = BASE_PATH + path + (hash ? '#' + hash : '');
  if (window.location.pathname + window.location.hash === full) return;
  history.pushState(null, '', full);
}

// Strips BASE_PATH from the current pathname the same way index.php's
// router does, so route parsing always sees paths as if mounted at root.
function currentRoutePath() {
  let path = window.location.pathname;
  if (BASE_PATH && path.indexOf(BASE_PATH) === 0) path = path.slice(BASE_PATH.length);
  return path;
}

function setActiveNavLink(key) {
  document.querySelectorAll('.nav-link').forEach(x => x.classList.toggle('active', x.dataset.nav === key));
}

// Shared by nav-link clicks and path-based routing (direct link, back/forward,
// typed-in-address-bar) so both paths open the exact same view.
function activateNavKey(key, { updatePath = true, path = null } = {}) {
  if (SUBPAGES[key]) {
    if (!dom.modal.hidden) closeModal();
    closeRulersPage();
    closeAtGlancePage();
    closeMapPage();
    const loaded = openSubpage(key, path || SUBPAGES[key].path);
    setActiveNavLink(key === 'prime-ministers' ? 'rulers-dynasties' : key);
    if (updatePath) setLocationPath('/' + (path || SUBPAGES[key].path));
    return loaded;
  }
  closeSubpages();
  if (key === 'rulers-dynasties') {
    if (!dom.modal.hidden) closeModal();
    closeAtGlancePage();
    closeMapPage();
    openRulersPage();
  } else if (key === 'at-glance') {
    if (!dom.modal.hidden) closeModal();
    closeRulersPage();
    closeMapPage();
    openAtGlancePage();
  } else if (key === 'overview') {
    goToHome();
  } else if (key === 'map') {
    if (!dom.modal.hidden) closeModal();
    closeRulersPage();
    closeAtGlancePage();
    openMapPage();
  } else {
    closeRulersPage();
    closeAtGlancePage();
    closeMapPage();
    if (NAV_MODALS[key]) openNavModal(key);
  }
  setActiveNavLink(key);
  if (updatePath && NAV_KEY_TO_PATH[key]) setLocationPath('/' + NAV_KEY_TO_PATH[key]);
}

// Cross-fades the shared modal's content in place — used when swapping
// between an event and a ruler profile within the same open overlay,
// instead of closing and reopening it.
function fadeSwapModal(renderFn) {
  const content = dom.modalContent;
  if (!content) { renderFn(); return; }

  content.classList.add('is-swapping');
  setTimeout(() => {
    renderFn();
    requestAnimationFrame(() => content.classList.remove('is-swapping'));
  }, 80);
}

// Closes whatever the shared #modal element currently shows, and — only if
// it was one of the top-level nav destinations (map/legacy/bibliography/
// about), not an event popup or ruler-profile overlay — resets the hash and
// nav-link highlight back to the timeline, matching the Timeline nav link.
function closeModalAndSyncHash() {
  // An event opened from a ruler profile's "Events During Reign" list closes
  // back into that ruler's profile, not all the way out to the timeline —
  // the visitor came from there and likely still wants to read about them.
  // Same for an event opened from a prime minister's "Events in Office".
  if (state.modalReturnPm) {
    const id = state.modalReturnPm;
    state.modalReturnPm = null;
    fadeSwapModal(() => openPmProfileModal(id));
    return;
  }
  if (state.modalReturnRuler) {
    const ruler = state.modalReturnRuler;
    state.modalReturnRuler = null;
    fadeSwapModal(() => openRulerProfileModal(ruler));
    return;
  }
  // Mirror image: a ruler profile opened from an event's "Who Was in Power"
  // card (or a Predecessor/Successor link) closes back into that event.
  if (state.modalReturnEvent) {
    const { era, eventIndex, eraIndex } = state.modalReturnEvent;
    state.modalReturnEvent = null;
    fadeSwapModal(() => openModal(era, eventIndex, eraIndex));
    return;
  }
  // An event opened from the At a Glance page's Key Events list closes
  // straight back into it — that page was never actually closed, it's
  // just been sitting underneath this modal the whole time (same layering
  // as a ruler profile over the Rulers & Dynasties page), so this only
  // needs to resync the URL/nav-link, not reopen anything.
  if (state.modalReturnAtGlance) {
    state.modalReturnAtGlance = false;
    closeModal();
    setActiveNavLink('at-glance');
    setLocationPath('/at-glance');
    return;
  }

  const isNavLevelModal = dom.modal.classList.contains('map-modal')
    || dom.modal.classList.contains('bibliography-modal')
    || dom.modal.classList.contains('author-modal')
    || dom.modal.classList.contains('legacy-modal');
  const wasPmProfile = Boolean(state.modalPm);
  const wasRulerProfile = dom.modal.classList.contains('rp-profile-modal');
  const wasEventModal = dom.modal.classList.contains('em-modal');
  closeModal();
  state.modalPm = null;
  if (wasPmProfile) {
    // Sits on top of the Prime Ministers page, which stays open underneath.
    setLocationPath('/rulers/prime-ministers');
  } else if (isNavLevelModal) {
    setActiveNavLink('overview');
    setLocationPath('/timeline');
  } else if (wasRulerProfile) {
    // The ruler profile modal sits on top of the Rulers & Dynasties page —
    // closing it directly (not via a return-to-event link) lands back there.
    setLocationPath('/rulers');
  } else if (wasEventModal) {
    setLocationPath('/timeline');
  }
}

// Resolves the current URL to a view. Used both at boot (hydrating
// whatever main.js loaded on top of) and on popstate (back/forward) — in
// both cases the browser has already applied the URL, so this never itself
// pushes a new history entry (activateNavKey is always called with
// updatePath: false here).
function routeFromPath() {
  const path = currentRoutePath().replace(/\/+$/, '') || '/';
  const parts = path === '/' ? [] : path.slice(1).split('/');

  if (parts.length === 2 && parts[0] === 'timeline') {
    const target = eventBySlug.get(parts[1]);
    if (target) {
      setActiveNavLink('overview');
      openModal(target.era, target.eventIndex);
      return;
    }
  }
  if (parts.length === 2 && parts[0] === 'rulers' && parts[1] === 'prime-ministers') {
    activateNavKey('prime-ministers', { updatePath: false });
    return;
  }
  // /rulers/prime-ministers/{id}: the page, then that prime minister's profile.
  if (parts.length === 3 && parts[0] === 'rulers' && parts[1] === 'prime-ministers') {
    activateNavKey('prime-ministers', { updatePath: false }).then(() => {
      if (pmById(parts[2])) openPmProfileModal(parts[2]);
      else setLocationPath('/rulers/prime-ministers');
    });
    return;
  }
  if (parts.length === 2 && parts[0] === 'houses') {
    activateNavKey('houses', { updatePath: false, path: 'houses/' + parts[1] });
    return;
  }
  if (parts.length === 2 && parts[0] === 'rulers') {
    const idx = rulerIndexBySlug.get(parts[1]);
    if (idx != null) {
      // Captured before openRulerProfileModal runs — it syncs the URL to a
      // bare /rulers/{slug} itself, which would otherwise clear this hash
      // before we get a chance to read it.
      const wantsFamilyTree = window.location.hash === '#family-tree';
      closeSubpages();
      openRulersPage();
      setActiveNavLink('rulers-dynasties');
      openRulerProfileModal(RULERS[idx]);
      if (wantsFamilyTree) openFamilyTreeLightbox(RULERS[idx]);
      return;
    }
  }

  const key = parts.length === 0 ? 'overview' : (parts.length === 1 ? PATH_TO_NAV_KEY[parts[0]] : null);
  if (key) activateNavKey(key, { updatePath: false });

  // /rulers#<dynasty-slug> (as set by "View Full Dynasty" — see
  // viewFullDynasty) — pre-filters the page to that dynasty on direct load
  // or back/forward, same as clicking its legend entry would.
  if (key === 'rulers-dynasties' && window.location.hash) {
    const dynastyId = dynastyIdFromSlug(window.location.hash.slice(1));
    if (dynastyId) {
      setRpTab('all');
      setRpDynastyFilter(dynastyId);
    }
  }
}

/* ─────────────────────────────────────────
   MAP MODAL — interactive territory timeline
   Every 25 years from 950, the map crossfades to the
   latest TIMELINE_MAPS entry whose year has been reached
   (see nearestMapEntry), alongside the ruler in power and
   the nearest recorded event for that year.
───────────────────────────────────────── */
const MAP_NAV_ICON_PREV = `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const MAP_NAV_ICON_NEXT = `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

let mapCurrentFile = null; // last-painted image src, so setMapYear can skip a no-op crossfade
let mapLayerActive = 'a';

// One tick per MAP_STEP years, spanning from MAP_START to just past the
// newest available map — a fixed grid rather than one tick per image, since
// the source maps land on irregular years.
function getMapStepYears() {
  return TIMELINE_MAPS.map(entry => entry.year);
}

// Latest map whose year has already been reached — never a map dated
// later than `year`, so the 1929 United Kingdom map only appears once the
// active year reaches 1929.
function nearestMapEntry(year) {
  if (!TIMELINE_MAPS.length) return null;
  return TIMELINE_MAPS.reduce((best, entry) => {
    if (entry.year > year) return best;
    if (!best || entry.year > best.year) return entry;
    return best;
  }, null);
}

// Nearest recorded eras to a given year — used for the "What happened
// around" list. Same proximity search as getWorldEventsForYear, since map
// steps (every 25 years) rarely land on an exact event year: take the
// closest few by distance, then re-order them chronologically for display.
function nearestErasForYear(year, count = 3, maxDistance = 60) {
  const eras = state.eras.filter(e => !e.isIntro && e.year != null);
  if (!eras.length) return [];
  return eras
    .map(e => ({ e, dist: Math.abs(e.year - year) }))
    .filter(x => x.dist <= maxDistance)
    .sort((a, b) => a.dist - b.dist || a.e.year - b.e.year)
    .slice(0, count)
    .map(x => x.e)
    .sort((a, b) => a.year - b.year);
}

function openMapModal() {
  if (!TIMELINE_MAPS.length) return;

  state.modalEvent = null;
  state.modalRuler = null;
  state.modalPm = null;
  dom.modal.classList.remove('rp-profile-modal', 'em-modal', 'bibliography-modal', 'author-modal', 'legacy-modal');
  dom.modal.classList.add('map-modal');
  dom.modalPrevious.hidden = true;
  dom.modalNext.hidden = true;
  dom.modalYearTag.textContent = '';
  dom.modalTitle.textContent = 'Territory & Geography';

  const steps = getMapStepYears();

  dom.modalBody.innerHTML = `
    <div class="map-modal-layout">
      <div class="map-main-col">
        <div class="map-stage">
          <div class="map-stage-layer map-stage-layer--a"></div>
          <div class="map-stage-layer map-stage-layer--b"></div>
          <span class="map-year-badge"></span>
          <div class="map-hint" id="map-hint">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2v9M4 7.5L8 11.5L12 7.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Click the dates below the map</span>
          </div>
        </div>
        <div class="map-timeline" aria-label="Map year timeline">
          <button type="button" class="map-tl-arrow map-tl-prev" aria-label="Earlier">${MAP_NAV_ICON_PREV}</button>
          <div class="map-tl-track">
            <div class="map-tl-inner">
              ${steps.map(y => `<button type="button" class="map-tl-tick" data-year="${y}">${y}</button>`).join('')}
            </div>
          </div>
          <button type="button" class="map-tl-arrow map-tl-next" aria-label="Later">${MAP_NAV_ICON_NEXT}</button>
        </div>
      </div>
      <div class="map-side-col">
        <div class="map-info-col map-info-event"></div>
        <div class="map-info-col map-info-power"></div>
      </div>
    </div>
    <div class="modal-source">
      <button type="button" class="modal-mistake-btn">
        <svg class="modal-mistake-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"/><line x1="8" y1="4.8" x2="8" y2="8.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="8" cy="11" r="0.9" fill="currentColor"/></svg>
        Noticed a mistake or have suggestions?
      </button>
    </div>`;

  const mapHint = dom.modalBody.querySelector('#map-hint');
  const hideMapHint = () => { if (mapHint) mapHint.classList.add('is-hidden'); };

  const track = dom.modalBody.querySelector('.map-tl-track');
  track.querySelectorAll('.map-tl-tick').forEach(btn => {
    btn.addEventListener('click', () => { setMapYear(Number(btn.dataset.year), true); hideMapHint(); });
  });
  dom.modalBody.querySelector('.map-tl-prev').addEventListener('click', () => { stepMapYear(-1); hideMapHint(); });
  dom.modalBody.querySelector('.map-tl-next').addEventListener('click', () => { stepMapYear(1); hideMapHint(); });

  const mapMistakeBtn = dom.modalBody.querySelector('.modal-mistake-btn');
  if (mapMistakeBtn) mapMistakeBtn.addEventListener('click', openContactModal);

  mapCurrentFile = null;
  const initialYear = steps.length
    ? steps.reduce((best, y) => Math.abs(y - (state.mapYear ?? 1400)) < Math.abs(best - (state.mapYear ?? 1400)) ? y : best)
    : (TIMELINE_MAPS[0]?.year ?? 600);
  setMapYear(initialYear, false);

  dom.modal.hidden = false;
  document.body.style.overflow = 'hidden';
  requestAnimationFrame(() => requestAnimationFrame(() => {
    dom.modalPanel.classList.add('is-open');
  }));
}

function stepMapYear(direction) {
  const steps = getMapStepYears();
  if (!steps.length) return;
  const idx = steps.indexOf(state.mapYear);
  const nextIdx = idx === -1 ? 0 : Math.max(0, Math.min(steps.length - 1, idx + direction));
  setMapYear(steps[nextIdx], true);
}

function setMapYear(year, animate) {
  const steps = getMapStepYears();
  if (steps.length) year = Math.max(steps[0], Math.min(steps[steps.length - 1], year));
  state.mapYear = year;

  const entry = nearestMapEntry(year);
  if (entry && entry.file !== mapCurrentFile) {
    mapCurrentFile = entry.file;
    const layerIn  = mapLayerActive === 'a' ? dom.modalBody.querySelector('.map-stage-layer--a') : dom.modalBody.querySelector('.map-stage-layer--b');
    const layerOut = mapLayerActive === 'a' ? dom.modalBody.querySelector('.map-stage-layer--b') : dom.modalBody.querySelector('.map-stage-layer--a');
    if (layerIn) {
      layerIn.style.backgroundImage = `url('${entry.file}')`;
      if (animate) {
        layerIn.classList.remove('active', 'fadeout');
        layerIn.classList.add('active');
        if (layerOut) { layerOut.classList.remove('active'); layerOut.classList.add('fadeout'); }
      } else {
        layerIn.classList.remove('fadeout');
        layerIn.classList.add('active');
        if (layerOut) layerOut.classList.remove('active', 'fadeout');
      }
      mapLayerActive = mapLayerActive === 'a' ? 'b' : 'a';
    }
  }

  const badge = dom.modalBody.querySelector('.map-year-badge');
  if (badge) badge.textContent = entry?.label ? `${year} · ${entry.label}` : year;

  const eventCol = dom.modalBody.querySelector('.map-info-event');
  if (eventCol) {
    const eras = nearestErasForYear(year);
    eventCol.innerHTML = eras.length ? `
      <div class="map-info-heading"><span>What happened around ${year}</span></div>
      <div class="em-world-list">
        ${eras.map(era => {
          const event = era.events[0];
          return `
          <div class="em-world-item">
            <span class="em-world-year">${era.year}</span>
            <div class="em-world-text">
              <span class="em-world-title">${escapeHtml(event.title)}</span>
              <span class="em-world-desc">${escapeHtml(event.text || '')}</span>
            </div>
          </div>`;
        }).join('')}
      </div>
    ` : '';
  }

  const powerCol = dom.modalBody.querySelector('.map-info-power');
  if (powerCol) {
    powerCol.innerHTML = emWhoIsInPowerHtml(year);
    powerCol.querySelectorAll('.em-power-card[data-ruler-idx]').forEach(el => {
      const open = () => {
        const ruler = RULERS[Number(el.dataset.rulerIdx)];
        if (ruler) openRulerProfileModal(ruler);
      };
      el.addEventListener('click', open);
      el.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    });
  }

  const track = dom.modalBody.querySelector('.map-tl-track');
  const inner = dom.modalBody.querySelector('.map-tl-inner');
  if (track && inner) {
    let activeBtn = null;
    inner.querySelectorAll('.map-tl-tick').forEach(btn => {
      const isActive = Number(btn.dataset.year) === year;
      btn.classList.toggle('active', isActive);
      if (isActive) activeBtn = btn;
    });
    if (activeBtn) {
      requestAnimationFrame(() => {
        const trackW = track.offsetWidth;
        const shift  = trackW / 2 - activeBtn.offsetLeft - activeBtn.offsetWidth / 2;
        inner.style.transform = `translateX(${shift}px)`;
      });
    }
  }
}

