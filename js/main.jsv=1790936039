function getAdjacentModalEvent(direction) {
  if (!state.modalEvent) return null;

  const ordered = getOrderedEras();
  let { eraIndex, eventIndex } = state.modalEvent;
  eventIndex += direction;

  if (direction < 0 && eventIndex < 0) {
    eraIndex -= 1;
    if (eraIndex < 0) return null;
    eventIndex = ordered[eraIndex].events.length - 1;
  } else if (direction > 0 && eventIndex >= ordered[eraIndex].events.length) {
    eraIndex += 1;
    if (eraIndex >= ordered.length) return null;
    eventIndex = 0;
  }

  const era = ordered[eraIndex];
  const event = era && era.events[eventIndex];
  return event ? { eraIndex, eventIndex, era, event } : null;
}

function updateModalNavigation() {
  if (state.modalPm) {
    const prev = getAdjacentPm(state.modalPm, -1);
    const next = getAdjacentPm(state.modalPm, 1);
    dom.modalPrevious.hidden = false;
    dom.modalNext.hidden = false;
    dom.modalPrevious.disabled = !prev;
    dom.modalNext.disabled = !next;
    dom.modalPrevious.setAttribute('aria-label', prev ? `Previous prime minister: ${prev.name}` : 'No previous prime minister');
    dom.modalNext.setAttribute('aria-label', next ? `Next prime minister: ${next.name}` : 'No next prime minister');
    return;
  }
  if (state.modalRuler) {
    const prev = getAdjacentRuler(state.modalRuler, -1);
    const next = getAdjacentRuler(state.modalRuler, 1);
  // Exclude period entries from individual ruler navigation.
  const usablePrev = prev && prev.reignLabel === 'Period' ? null : prev;

    dom.modalPrevious.hidden = false;
    dom.modalNext.hidden = false;
    dom.modalPrevious.disabled = !usablePrev;
    dom.modalNext.disabled = !next;
    dom.modalPrevious.setAttribute('aria-label', usablePrev ? `Previous ruler: ${usablePrev.name}` : 'No previous ruler');
    dom.modalNext.setAttribute('aria-label', next ? `Next ruler: ${next.name}` : 'No next ruler');
    return;
  }

  const previous = getAdjacentModalEvent(-1);
  const next = getAdjacentModalEvent(1);
  const isEventModal = Boolean(state.modalEvent);

  dom.modalPrevious.hidden = !isEventModal;
  dom.modalNext.hidden = !isEventModal;
  dom.modalPrevious.disabled = !previous;
  dom.modalNext.disabled = !next;
  dom.modalPrevious.setAttribute('aria-label', previous ? `Previous event: ${previous.event.title}` : 'No previous event');
  dom.modalNext.setAttribute('aria-label', next ? `Next event: ${next.event.title}` : 'No next event');
}

// Shared by the modal's prev/next arrow buttons and arrow keys — dispatches
// to whichever navigation mode the open modal is in.
function navigateModal(direction) {
  if (state.modalPm) {
    const target = getAdjacentPm(state.modalPm, direction);
    if (target) fadeSwapModal(() => openPmProfileModal(target.id));
    return;
  }
  if (state.modalRuler) { navigateModalRuler(direction); return; }
  navigateModalEvent(direction);
}

function navigateModalRuler(direction) {
  const target = getAdjacentRuler(state.modalRuler, direction);
  if (!target || target.reignLabel === 'Period') return;
  fadeSwapModal(() => openRulerProfileModal(target));
}

function navigateModalEvent(direction) {
  const target = getAdjacentModalEvent(direction);
  if (!target) return;

  fadeSwapModal(() => {
    if (target.eraIndex !== state.activeEra) {
      activateEra(target.eraIndex, false);
    }
    state.activeEvent = target.eventIndex;
    updateContent(target.era, target.eventIndex, false);
    updateEventVisual(target.era, target.eventIndex, false);
    openModal(target.era, target.eventIndex, target.eraIndex);
  });
}

function escapeHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function normaliseEventImages(event) {
  const configured = Array.isArray(event.images) && event.images.length
    ? event.images
    : (event.image ? [{ src: event.image }] : []);

  return configured.map((image, index) => {
    const item = typeof image === 'string' ? { src: image } : image;
    const credit = item.attribution || event.imageAttribution || {};
    return {
      src: item.src || item.url || '',
      alt: item.alt || `${event.title} historical image ${index + 1}`,
      caption: item.caption || credit.title || '',
    };
  }).filter(image => image.src);
}

function getEventSources(event) {
  const list = [];
  const seen = new Set();

  const push = (url, label) => {
    if (!url || seen.has(url)) return;
    seen.add(url);
    list.push({ url, label: label || new URL(url, window.location.href).hostname.replace(/^www\./, '') });
  };

  if (Array.isArray(event.sources) && event.sources.length) {
    for (const s of event.sources) {
      if (typeof s === 'string') push(s, null);
      else push(s.url || s.href, s.label || s.title || null);
    }
  } else if (event.source || event.sourceUrl) {
    const s = event.source || event.sourceUrl;
    if (typeof s === 'string') push(s, null);
    else push(s.url || s.href, s.label || s.title || null);
  }

  const attribution = event.imageAttribution || {};
  if (attribution.articleUrl) push(attribution.articleUrl, 'Wikipedia');

  if (list.length === 0) {
    push(
      `https://en.wikipedia.org/wiki/Special:Search?search=${encodeURIComponent(event.title)}`,
      'Wikipedia (search)'
    );
  }

  return list;
}

function getSourceHost(url) {
  try {
    return new URL(url, window.location.href).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}

// Computes a transform-origin (relative to panelEl's own box) that lines up
// with triggerEl's centre, so a lightbox/modal visibly zooms in from
// whatever button/title opened it, rather than just growing from its own
// centre. panelEl's transform is neutralised for the instant of measuring —
// getBoundingClientRect reflects whatever transform is *currently* applied,
// and a box already scaled down around its default (centre) origin has
// edges that no longer line up with its true, unscaled position.
function transformOriginFromTrigger(panelEl, triggerEl) {
  const prevTransform = panelEl.style.transform;
  panelEl.style.transform = 'none';
  const panelRect = panelEl.getBoundingClientRect();
  panelEl.style.transform = prevTransform;

  const btnRect = triggerEl.getBoundingClientRect();
  const originX = btnRect.left + btnRect.width / 2 - panelRect.left;
  const originY = btnRect.top + btnRect.height / 2 - panelRect.top;
  return `${originX}px ${originY}px`;
}

// triggerEl (the portrait or gallery thumbnail that was clicked) makes the
// lightbox zoom in from that element instead of its own centre — same
// zoom-from-trigger feel as the family tree lightbox below.
function openImageLightbox(image, triggerEl) {
  if (!image) return;
  dom.lightboxImg.src = image.src;
  dom.lightboxImg.alt = image.alt;
  if (image.captionHtml) {
    dom.lightboxCaption.innerHTML = image.captionHtml;
  } else {
    dom.lightboxCaption.textContent = image.caption || '';
  }
  dom.lightboxCaption.hidden = !(image.captionHtml || image.caption);
  dom.imageLightbox.hidden = false;

  dom.lightboxFigure.style.transformOrigin = triggerEl
    ? transformOriginFromTrigger(dom.lightboxFigure, triggerEl)
    : '';

  requestAnimationFrame(() => dom.imageLightbox.classList.add('is-open'));
}

