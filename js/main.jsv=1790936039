   MODAL
───────────────────────────────────────── */
const EM_ICON_BOOK = `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H11v18H5.5A1.5 1.5 0 0 1 4 19.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M20 4.5A1.5 1.5 0 0 0 18.5 3H13v18h5.5a1.5 1.5 0 0 0 1.5-1.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;

// Nearest world events (by absolute year distance) used in the "Meanwhile
// in Europe and the world" sidebar — deliberately a proximity search rather
// than a strict range, since sparse coverage means an exact-year match is
// rare, but the closest handful of entries are still useful context.
function getWorldEventsForYear(year, count = 4, maxDistance = 60) {
  if (!Array.isArray(WORLD_EVENTS) || !WORLD_EVENTS.length || year == null) return [];
  return WORLD_EVENTS
    .map(e => ({ ...e, dist: Math.abs(e.year - year) }))
    .filter(e => e.dist <= maxDistance)
    .sort((a, b) => a.dist - b.dist || a.year - b.year)
    .slice(0, count)
    .sort((a, b) => a.year - b.year);
}

// "Who was in power" block for the event modal — just the ruler active in
// that exact year, reusing the same RULERS lookup as the ruler-profile
// modal so the two stay in sync without duplicating data.
function emWhoIsInPowerHtml(year) {
