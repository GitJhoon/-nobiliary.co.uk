/* ─────────────────────────────────────────
   BIND EVENTS
───────────────────────────────────────── */
// Toggles .is-scrolled on a scrolling overlay (#modal, #rulers-page,
// #at-glance-page) as soon as it's scrolled at all — style.css shrinks the
// sticky title bar's heading with a CSS transition while that class is
// present, so the shrink itself reads as a smooth scale-down rather than
// an instant jump.
function bindTitleShrink(el) {
  if (!el) return;
  el.addEventListener('scroll', () => {
    el.classList.toggle('is-scrolled', el.scrollTop > 4);
  }, { passive: true });
}

// Marks the era navigation only when it has reached its desktop sticky
// position. This is intentionally separate from .is-scrolled, which is set
// as soon as the page moves and therefore fires before the navigation sticks.
// Map page: a scroll down that stops between the top of the page and the
// era buttons' sticky position finishes the trip, so the header gets out of
// the way and the eras, slider and map are all in view. Scrolling up is
// left alone. Desktop/tablet only, matching where .cm-controls is sticky.
function bindMapControlsSnap(scroller, controls) {
  if (!scroller || !controls) return;
  let lastTop = scroller.scrollTop, goingDown = false, timer = 0;
  scroller.addEventListener('scroll', () => {
    const top = scroller.scrollTop;
    goingDown = top > lastTop;
    lastTop = top;
    clearTimeout(timer);
    timer = setTimeout(() => {
      if (!goingDown || !window.matchMedia('(min-width:901px)').matches) return;
      const pad = parseFloat(getComputedStyle(scroller).paddingTop) || 0;
      const stickTop = scroller.getBoundingClientRect().top + pad + (parseFloat(getComputedStyle(controls).top) || 0);
      const target = scroller.scrollTop + controls.getBoundingClientRect().top - stickTop;
      if (scroller.scrollTop > 0 && scroller.scrollTop < target - 2) {
        scroller.scrollTo({ top: target, behavior: 'smooth' });
      }
    }, 140);
  }, { passive:true });
}

function bindAgEraStickyState(scroller, list) {
  if (!scroller || !list) return;
  const update = () => {
    const desktop = window.matchMedia('(min-width:901px)').matches;
    // Sticky offsets are measured inside the scroller's padding box.
    const stickyTop = scroller.getBoundingClientRect().top
      + (parseFloat(getComputedStyle(scroller).paddingTop) || 0)
      + (parseFloat(getComputedStyle(list).top) || 0);
    const stuck = desktop && scroller.scrollTop > 0 && list.getBoundingClientRect().top <= stickyTop + 1;
    list.classList.toggle('is-stuck', stuck);
    // At a Glance only (lists declaring --ag-era-compact): collapse the
    // cards only once the content below has reached the compact bar's
    // bottom edge, so shrinking never leaves a gap above the content. The
    // list's height + margin-bottom is constant, so toggling this doesn't
    // move the content and can't oscillate.
    const compactH = parseFloat(getComputedStyle(list).getPropertyValue('--ag-era-compact'));
    if (compactH) {
      const next = [...list.parentElement.children].find(el => el !== list && !el.hidden && el.offsetParent);
      list.classList.toggle('is-compact', stuck && !!next && next.getBoundingClientRect().top <= stickyTop + compactH + 1);
    }
  };
  scroller.addEventListener('scroll', update, { passive:true });
  window.addEventListener('resize', update, { passive:true });
  update();
}

function bindEvents() {
  // Direction arrows — set ascending or descending year order
  dom.orderAsc.addEventListener('click',  () => setOrder('asc'));
  dom.orderDesc.addEventListener('click', () => setOrder('desc'));

  // Filter dropdown
  dom.filterBtn.addEventListener('click', e => {
    e.stopPropagation();
    const isOpen = !dom.filterMenu.hidden;
    dom.filterMenu.hidden = isOpen;
    dom.filterBtn.classList.toggle('is-open', !isOpen);
    dom.filterBtn.setAttribute('aria-expanded', String(!isOpen));
  });
  dom.filterMenu.addEventListener('click', e => {
    const opt = e.target.closest('.filter-option');
    if (!opt) return;
    setFilter(opt.dataset.filter);
    dom.filterMenu.hidden = true;
    dom.filterBtn.classList.remove('is-open');
    dom.filterBtn.setAttribute('aria-expanded', 'false');
  });
  document.addEventListener('click', e => {
    if (dom.filterWrap && !dom.filterWrap.contains(e.target)) {
      dom.filterMenu.hidden = true;
      dom.filterBtn.classList.remove('is-open');
      dom.filterBtn.setAttribute('aria-expanded', 'false');
    }
  });

  // Language dropdown — a single "EN" option, but opens/closes like a real dropdown
  if (dom.langToggle && dom.langMenu) {
    dom.langToggle.addEventListener('click', e => {
      e.stopPropagation();
      const isOpen = !dom.langMenu.hidden;
      dom.langMenu.hidden = isOpen;
      dom.langToggle.classList.toggle('is-open', !isOpen);
      dom.langToggle.setAttribute('aria-expanded', String(!isOpen));
    });
    dom.langMenu.addEventListener('click', e => {
      if (!e.target.closest('.lang-option')) return;
      dom.langMenu.hidden = true;
      dom.langToggle.classList.remove('is-open');
      dom.langToggle.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('click', e => {
      if (dom.langWrap && !dom.langWrap.contains(e.target)) {
        dom.langMenu.hidden = true;
        dom.langToggle.classList.remove('is-open');
        dom.langToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Share dropdowns — one per panel that can have a real shareable URL
  bindShareMenu(dom.modalShareWrap, dom.modalShareBtn, dom.modalShareMenu);
  bindShareMenu(dom.rpShareWrap, dom.rpShareBtn, dom.rpShareMenu);
  bindShareMenu(dom.agShareWrap, dom.agShareBtn, dom.agShareMenu);
  bindShareMenu(dom.cmShareWrap, dom.cmShareBtn, dom.cmShareMenu);

  // Search
  dom.searchInput.addEventListener('input', () => setSearch(dom.searchInput.value));
  dom.searchInput.addEventListener('keydown', e => { if (e.key === 'Escape') { dom.searchInput.value = ''; setSearch(''); } });
  dom.searchClear.addEventListener('click', () => { dom.searchInput.value = ''; setSearch(''); dom.searchInput.focus(); });

  // Filter banner
  if (dom.filterBannerClear) dom.filterBannerClear.addEventListener('click', clearSearchAndFilter);

  // Event pagination
  dom.prevEvent.addEventListener('click', () => navigateEvent(-1));
  dom.nextEvent.addEventListener('click', () => navigateEvent(1));

  // Order toggle
  dom.orderToggle.addEventListener('click', toggleOrder);

  // Read More → modal
  dom.readMoreBtn.addEventListener('click', () => {
    const era = getOrderedEras()[state.activeEra];
    if (era) openModal(era, state.activeEvent);
  });

  // Ruler card (left side) → profile modal, same as the "View full profile" tooltip link
  dom.rulerCard.addEventListener('click', e => {
    const ruler = RULERS[state.activeRulerIdx];
    if (!ruler) return;
    if (e.target.closest('.rs-view-dynasty')) {
      viewFullDynasty(ruler);
    } else {
      openRulerProfileModal(ruler);
    }
  });

  // Modal close
  dom.modalClose.addEventListener('click', closeModalAndSyncHash);
  dom.modalBackdrop.addEventListener('click', closeModalAndSyncHash);
  dom.modalPrevious.addEventListener('click', () => navigateModal(-1));
  dom.modalNext.addEventListener('click', () => navigateModal(1));
  dom.lightboxClose.addEventListener('click', closeImageLightbox);
  dom.lightboxBackdrop.addEventListener('click', closeImageLightbox);
  dom.familyTreeLightboxClose.addEventListener('click', closeFamilyTreeLightbox);
  dom.familyTreeLightboxBackdrop.addEventListener('click', closeFamilyTreeLightbox);
  if (dom.mapViewer) {
    dom.mapViewerClose.addEventListener('click', closeMapViewer);
    dom.mapViewerBackdrop.addEventListener('click', closeMapViewer);
  }

  // ── Wheel: accumulate delta, jump proportional number of eras ──
  const WHEEL_STEP = 190;     // px per era step — ~one standard mouse notch on default Windows settings
  const WHEEL_MAX_STEP = 3;   // max eras jumped in one burst
  let wheelResetTimer = null;

  window.addEventListener('wheel', e => {
    if (!dom.modal.hidden) return;
    // Full-page overlays (Rulers & Dynasties, At a Glance, Noble Family
    // profile) need their own native scroll — without this they'd never
    // receive wheel input at all, since it'd always be consumed here for
    // era-navigation first. familyPage only exists in the DOM at all on
    // /families and /families/{slug} (see includes/render-family.php), so
    // its mere presence already means "this route, don't hijack scroll".
    if (!dom.rulersPage.hidden || !dom.atGlancePage.hidden || (dom.mapPage && !dom.mapPage.hidden) || subpageOpen() || dom.familyPage) return;
    e.preventDefault();

    state.wheelAccum += e.deltaY;

    const raw   = Math.trunc(state.wheelAccum / WHEEL_STEP);
    const steps = Math.sign(raw) * Math.min(Math.abs(raw), WHEEL_MAX_STEP);
    if (steps !== 0) {
      state.wheelAccum -= steps * WHEEL_STEP;
      goToEra(state.activeEra + steps);
    }

    clearTimeout(wheelResetTimer);
    wheelResetTimer = setTimeout(() => { state.wheelAccum = 0; }, 300);
  }, { passive: false });

  // ── Keyboard ──
  document.addEventListener('keydown', e => {
    // The map framed by the map viewer (/map?embed=1): Escape closes the
    // viewer in the page around it rather than leaving the map.
    if (e.key === 'Escape' && document.body.classList.contains('map-embed')) {
      if (window.parent !== window && window.parent.closeMapViewer) window.parent.closeMapViewer();
      return;
    }
    if (dom.mapViewer && !dom.mapViewer.hidden) {
      if (e.key === 'Escape') closeMapViewer();
      return;
    }
    if (!dom.familyTreeLightbox.hidden) {
      if (e.key === 'Escape') closeFamilyTreeLightbox();
      return;
    }
    if (!dom.imageLightbox.hidden) {
      if (e.key === 'Escape') closeImageLightbox();
      return;
    }
    if (!dom.contactModal.hidden) {
      if (e.key === 'Escape') closeContactModal();
      return;
    }
    if (!dom.modal.hidden) {
      if (e.key === 'Escape') closeModalAndSyncHash();
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        navigateModal(-1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        navigateModal(1);
      }
      return;
    }
    // The map page has its own shortcuts (chapters, play) — the hidden
    // timeline underneath must not react to them.
    if (dom.mapPage && !dom.mapPage.hidden) {
      if (e.key === 'Escape') {
        closeMapPage();
        setActiveNavLink('overview');
        setLocationPath('/timeline');
      } else {
        window.BritishMap.handleKey(e);
      }
      return;
    }
    switch (e.key) {
      case 'ArrowDown': case 'PageDown':
        e.preventDefault(); goToEra(state.activeEra + 1); break;
      case 'ArrowUp': case 'PageUp':
        e.preventDefault(); goToEra(state.activeEra - 1); break;
      case 'ArrowRight': navigateEvent(1);  break;
      case 'ArrowLeft':  navigateEvent(-1); break;
      case 'Home': e.preventDefault(); goToEra(0); break;
      case 'End':  e.preventDefault(); goToEra(state.eras.length - 1); break;
    }
  });

  // ── Touch swipe ──
  // Whichever axis moved further wins — the timeline runs vertically at
  // every breakpoint, so an up/down drag is the natural gesture, but a
  // clear left/right swipe (e.g. over the content panel) still navigates.
  let tx = 0, ty = 0;
  document.addEventListener('touchstart', e => {
    tx = e.touches[0].clientX;
    ty = e.touches[0].clientY;
  }, { passive: true });
  document.addEventListener('touchend', e => {
    if (!dom.modal.hidden) return;
    if (dom.mapPage && !dom.mapPage.hidden) return;
    const dx = tx - e.changedTouches[0].clientX;
    const dy = ty - e.changedTouches[0].clientY;
    if (Math.abs(dx) > Math.abs(dy)) {
      if (Math.abs(dx) < 44) return;
      goToEra(state.activeEra + (dx > 0 ? 1 : -1));
    } else {
      if (Math.abs(dy) < 44) return;
      goToEra(state.activeEra + (dy > 0 ? 1 : -1));
    }
  }, { passive: true });

  // Contact modal
  dom.mistakeLink.addEventListener('click', openContactModal);
  if (dom.rpMistakeBtn) dom.rpMistakeBtn.addEventListener('click', openContactModal);
  dom.contactModalClose.addEventListener('click', closeContactModal);
  dom.contactModalBackdrop.addEventListener('click', closeContactModal);
  dom.contactForm.addEventListener('submit', async e => {
    e.preventDefault();
    const submit   = dom.contactForm.querySelector('.contact-submit');
    const feedback = document.getElementById('contact-feedback');

    submit.disabled    = true;
    submit.textContent = 'Sending…';
    feedback.textContent = '';
    feedback.className = 'contact-feedback';

    try {
      const token    = await getRecaptchaToken('contact_form');
      const formData = new FormData(dom.contactForm);
      formData.set('g-recaptcha-response', token);
      const res  = await fetch('contact-handler.php', {
        method:  'POST',
        headers: { Accept: 'application/json' },
        body:    formData,
      });
      const json = await res.json();
      if (res.ok) {
        feedback.textContent = json.message || 'Your message has been sent. Thank you!';
        feedback.className   = 'contact-feedback contact-feedback--success';
        dom.contactForm.reset();
      } else {
        feedback.textContent = json.message || 'Something went wrong. Please try again.';
        feedback.className   = 'contact-feedback contact-feedback--error';
      }
    } catch {
      feedback.textContent = 'Could not send the message. Please try again later.';
      feedback.className   = 'contact-feedback contact-feedback--error';
    } finally {
      submit.disabled    = false;
      submit.textContent = 'Send a message';
    }
  });

  // ── Logo: return to start (intro) ──
  if (dom.appLogoBtn) {
    dom.appLogoBtn.addEventListener('click', () => {
      goToHome();
      closeMobileNav();
    });
  }

  // ── Nav links ──
  document.querySelectorAll('.nav-link[data-nav]').forEach(l => {
    l.addEventListener('click', e => {
      e.preventDefault();
      activateNavKey(l.dataset.nav);
      closeMobileNav();
    });
  });

  // ── URL path routing — /timeline, /rulers, /map, /legacy, /bibliography, /about (and their deep links) ──
  window.addEventListener('popstate', routeFromPath);

  // ── Mobile burger menu ──
  if (dom.navBurger) {
    dom.navBurger.addEventListener('click', () => {
      const isOpen = dom.navLinksList.classList.toggle('is-open');
      dom.navBurger.setAttribute('aria-expanded', String(isOpen));
      dom.navBurger.classList.toggle('is-open', isOpen);
    });
  }
  document.addEventListener('click', e => {
    if (!dom.navLinksList || !dom.navLinksList.classList.contains('is-open')) return;
    if (dom.navLinksList.contains(e.target) || dom.navBurger.contains(e.target)) return;
    closeMobileNav();
  });

  // ── Rulers & Dynasties page ──
  if (dom.rpClose) dom.rpClose.addEventListener('click', () => {
    closeRulersPage();
    setActiveNavLink('overview');
    setLocationPath('/timeline');
  });

  // ── At a Glance page ──
  if (dom.agClose) dom.agClose.addEventListener('click', () => {
    closeAtGlancePage();
    setActiveNavLink('overview');
    setLocationPath('/timeline');
  });

  // ── Map page ──
  if (dom.cmClose) dom.cmClose.addEventListener('click', () => {
    closeMapPage();
    setActiveNavLink('overview');
    setLocationPath('/timeline');
  });
  document.querySelectorAll('.cm-mistake-btn').forEach(btn => {
    btn.addEventListener('click', openContactModal);
  });

  // Sticky title shrink-on-scroll — shared #modal, plus the full pages
  bindTitleShrink(dom.modal);
  bindTitleShrink(dom.rulersPage);
  bindTitleShrink(dom.atGlancePage);
  bindTitleShrink(dom.mapPage);
  bindAgEraStickyState(dom.mapPage, dom.cmControls);
  bindMapControlsSnap(dom.mapPage, dom.cmControls);
  Object.keys(SUBPAGES).forEach(k => bindTitleShrink(subpageEl(k)));
  bindSubpageEvents();
  bindAgEraStickyState(dom.atGlancePage, dom.agEraList);
  document.querySelectorAll('.ag-detail-footer').forEach(footer => initModalSourceSlider(footer));
  document.querySelectorAll('.ag-mistake-btn').forEach(btn => {
    btn.addEventListener('click', openContactModal);
  });
  if (dom.agEraList) dom.agEraList.addEventListener('click', e => {
    const item = e.target.closest('.ag-era-item');
    if (item) setAgActiveEra(item.dataset.eraId);
  });
  if (dom.agEraList) dom.agEraList.addEventListener('keydown', e => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
    const items = [...dom.agEraList.querySelectorAll('.ag-era-item')];
    const current = e.target.closest('.ag-era-item');
    const currentIndex = items.indexOf(current);
    if (currentIndex < 0) return;
    e.preventDefault();
    let nextIndex = e.key === 'Home' ? 0 : e.key === 'End' ? items.length - 1
      : (currentIndex + (e.key === 'ArrowRight' ? 1 : -1) + items.length) % items.length;
    items[nextIndex].focus();
    setAgActiveEra(items[nextIndex].dataset.eraId);
  });
  document.querySelectorAll('.ag-explore-rulers').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const dynastyId = link.dataset.dynasty;
      if (!dynastyId) return;
      closeAtGlancePage();
      openRulersPage();
      setRpTab('all');
      setRpDynastyFilter(dynastyId);
      setActiveNavLink('rulers-dynasties');
      setLocationPath('/rulers', dynastySlug(dynastyId));
    });
  });

  // Key Events list — same hover-tooltip + click-to-open behavior as the
  // ruler modal's "Events During Reign" list (showRpEventTooltip et al.
  // are shared, generic utilities despite the "Rp" name). Only entries the
  // curated content links to a real event (.ag-event--linked, carrying
  // data-event-slug) are interactive; eventBySlug is looked up lazily
  // inside these callbacks rather than at bind time since buildSlugMaps()
  // hasn't run yet this early in init().
  document.querySelectorAll('.ag-event--linked').forEach(el => {
    const slug = el.dataset.eventSlug;
    const open = () => {
      const target = eventBySlug.get(slug);
      if (!target) return;
      hideRpEventTooltip();
      // Opening from here should land on top of the At a Glance page and,
      // on close, fade back into it rather than dropping to the timeline.
      state.modalReturnAtGlance = true;
      openModal(target.era, target.eventIndex);
    };
    el.addEventListener('click', open);
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });
    // Hero and theme cards already show their own text — tooltip only
    // for the Key Events rows.
    if (!el.classList.contains('ag-event')) return;

    const showTooltip = () => {
      const target = eventBySlug.get(slug);
      const text = target && target.era.events[target.eventIndex].text;
      if (text) showRpEventTooltip(text, el);
    };
    el.addEventListener('mouseenter', showTooltip);
    el.addEventListener('mouseleave', hideRpEventTooltip);
    el.addEventListener('focus', showTooltip);
    el.addEventListener('blur', hideRpEventTooltip);
  });

  // "View full timeline" / "Explore all N events" — back to the timeline,
  // positioned on the period's first event (no modal).
  document.querySelectorAll('.ag-timeline-link, .ag-explore-events').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const target = eventBySlug.get(link.dataset.eventSlug);
      closeAtGlancePage();
      setActiveNavLink('overview');
      setLocationPath('/timeline');
      if (!target) return;
      goToEra(getOrderedEras().indexOf(target.era));
    });
  });

  if (dom.rpSearchInput) {
    dom.rpSearchInput.addEventListener('input', () => setRpSearch(dom.rpSearchInput.value));
    dom.rpSearchInput.addEventListener('keydown', e => { if (e.key === 'Escape') { dom.rpSearchInput.value = ''; setRpSearch(''); } });
  }
  if (dom.rpSearchClear) dom.rpSearchClear.addEventListener('click', () => { dom.rpSearchInput.value = ''; setRpSearch(''); dom.rpSearchInput.focus(); });
  if (dom.rpTabs) dom.rpTabs.addEventListener('click', e => {
    const btn = e.target.closest('.rp-tab');
    if (btn) setRpTab(btn.dataset.tab);
  });
  if (dom.rpPagePrev) dom.rpPagePrev.addEventListener('click', rpPrevPage);
  if (dom.rpDynastyLabels) dom.rpDynastyLabels.addEventListener('click', e => {
    const btn = e.target.closest('.rp-dynasty-label[data-dynasty]');
    if (btn) setRpDynastyFilterAndSyncUrl(btn.dataset.dynasty);
  });
  if (dom.rpLegend) dom.rpLegend.addEventListener('click', e => {
    const btn = e.target.closest('.rp-legend-item[data-dynasty]');
    if (btn) setRpDynastyFilterAndSyncUrl(btn.dataset.dynasty);
  });
  if (dom.rpAvatars) {
    dom.rpAvatars.addEventListener('click', e => {
      if (e.target.closest('.rp-avatar-more')) { rpNextPage(); return; }
      const btn = e.target.closest('.rp-avatar[data-idx]');
      if (!btn) return;
      hideRpTooltip();
      openRulerProfileModal(RULERS[Number(btn.dataset.idx)]);
    });
    dom.rpAvatars.addEventListener('mouseover', e => {
      const btn = e.target.closest('.rp-avatar[data-idx]');
      if (btn) showRpTooltip(RULERS[Number(btn.dataset.idx)], btn);
    });
    dom.rpAvatars.addEventListener('mouseout', e => {
      const btn = e.target.closest('.rp-avatar[data-idx]');
      if (btn && !btn.contains(e.relatedTarget)) scheduleHideRpTooltip();
    });
    dom.rpAvatars.addEventListener('focusin', e => {
      const btn = e.target.closest('.rp-avatar[data-idx]');
      if (btn) showRpTooltip(RULERS[Number(btn.dataset.idx)], btn);
    });
    dom.rpAvatars.addEventListener('focusout', e => {
      const btn = e.target.closest('.rp-avatar[data-idx]');
      if (btn) scheduleHideRpTooltip();
    });
  }
  if (dom.rpTooltip) {
    dom.rpTooltip.addEventListener('mouseover', () => clearTimeout(rpTooltipHideTimer));
    dom.rpTooltip.addEventListener('mouseout', e => {
      if (!dom.rpTooltip.contains(e.relatedTarget)) scheduleHideRpTooltip();
    });
  }

  // ── Resize ──
  let rpResizeTimer = null;
  let eraNavResizeTimer = null;
  window.addEventListener('resize', () => {
    const start = Math.max(0, state.activeEra - WINDOW_HALF);
    positionTimeline(state.activeEra, start);

    // Debounced: mobile browsers (iOS Safari/Edge) fire `resize` repeatedly
    // while their address bar collapses/expands during a scroll, not just
    // on real viewport changes. updateEraNav() measures live layout via
    // rAF, so recalculating on every one of those transient firings could
    // catch the nav mid-transition and shove the chips off-screen — wait
    // for the burst to settle before trusting the measurement.
    clearTimeout(eraNavResizeTimer);
    eraNavResizeTimer = setTimeout(updateEraNav, 150);

    if (!dom.rulersPage.hidden) {
      clearTimeout(rpResizeTimer);
      rpResizeTimer = setTimeout(updateRpPageSize, 150);
    }
  });
}
