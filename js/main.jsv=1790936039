  // & Dynasties page, which can interrupt the running transition), the
  // modal's full-screen backdrop would otherwise stay stuck on top of
  // whatever opens next. The timeout is a safety net that force-hides it
  // regardless; `finished` stops the two from double-firing.
  let finished = false;
  const finish = () => {
