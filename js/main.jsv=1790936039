───────────────────────────────────────── */
function getRecaptchaToken(action) {
  const siteKey = document.querySelector('meta[name="recaptcha-site-key"]')?.content;
  if (!siteKey || typeof grecaptcha === 'undefined') return Promise.resolve('');
  return new Promise(resolve => {
    grecaptcha.ready(() => {
      grecaptcha.execute(siteKey, { action }).then(resolve).catch(() => resolve(''));
    });
  });
}

// Reads the currently visible page/modal directly from app state rather than
// document.title — the SPA never updates document.title on client-side route
// changes (setLocationPath only touches the URL), so it goes stale the moment
// a visitor navigates without a full reload.
function getCurrentPageLabel() {
  if (!dom.modal.hidden) {
    // Every modal type now shares the same sticky #modal-title (rp-profile
    // included, since it started rendering the ruler's name there too) —
    // rp-profile's year tag is always empty, so it naturally falls through
    // to the title-only case below.
    const year  = dom.modalYearTag.textContent.trim();
    const title = dom.modalTitle.textContent.trim();
    if (year && title) return `${year} - ${title}`;
    if (title) return title;
  }
  const activeNavKey = document.querySelector('.nav-link.active')?.dataset.nav;
  if (activeNavKey === 'rulers-dynasties') return 'Rulers & Dynasties';
  if (activeNavKey === 'at-glance') return 'At a Glance';
  if (activeNavKey === 'map') return 'British Expansion Through the Years';
  return 'Timeline';
}

function openContactModal() {
  dom.contactModal.hidden = false;
  document.body.style.overflow = 'hidden';
  if (dom.contactPage) dom.contactPage.value = getCurrentPageLabel();
  requestAnimationFrame(() => requestAnimationFrame(() => {
    dom.contactModalPanel.classList.add('is-open');
  }));
