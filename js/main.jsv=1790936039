function initModalSourceSlider(root = document) {
  const viewport = root.querySelector('.modal-source-slider');
  const next = root.querySelector('.modal-source-next');
  const prev = root.querySelector('.modal-source-prev');
  if (!viewport || !next) return;
  if (viewport.dataset.sliderReady === 'true') return;
  viewport.dataset.sliderReady = 'true';

  const update = () => {
    const overflow = viewport.scrollWidth > viewport.clientWidth + 2;
    const atStart = viewport.scrollLeft <= 2;
    const atEnd = viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 2;
    next.hidden = !overflow;
    next.disabled = overflow && atEnd;
    next.setAttribute('aria-label', atEnd ? 'All sources shown' : 'Show more sources');
    if (prev) {
      prev.hidden = !overflow;
      prev.disabled = overflow && atStart;
    }
  };

  next.addEventListener('click', () => {
    viewport.scrollBy({ left: Math.max(180, viewport.clientWidth * 0.75), behavior: 'smooth' });
  });
  if (prev) {
    prev.addEventListener('click', () => {
      viewport.scrollBy({ left: -Math.max(180, viewport.clientWidth * 0.75), behavior: 'smooth' });
    });
  }
  viewport.addEventListener('scroll', update, { passive: true });
  if ('ResizeObserver' in window) new ResizeObserver(update).observe(viewport);
  requestAnimationFrame(update);
}

function openModal(era, eventIndex, eraIndex = state.activeEra) {
  const event = era.events[eventIndex];
  if (!event) return;

  // Every path that opens an event (timeline click, pagination arrows,
  // "who was in power" cross-link, direct URL) funnels through here, so
  // updating the URL in this one place gives every one of them a real,
  // shareable /timeline/{slug} address for free.
  const slug = eraEventSlug(era, eventIndex);
  if (slug) setLocationPath('/timeline/' + slug);

  const ordered = getOrderedEras();
  const resolvedEraIndex = ordered[eraIndex] === era ? eraIndex : ordered.indexOf(era);
  state.modalEvent = resolvedEraIndex >= 0 ? { eraIndex: resolvedEraIndex, eventIndex } : null;
  state.modalRuler = null;
  state.modalPm = null;
  state.modalReturnEvent = null;
  dom.modal.classList.remove('rp-profile-modal', 'map-modal', 'bibliography-modal', 'author-modal', 'legacy-modal');
  dom.modal.classList.add('em-modal');
  updateModalNavigation();

  dom.modalYearTag.textContent = era.year;

  // Same battle/ruler-change/main-event glyphs as the timeline list's
  // .tl-cat-icon (CATEGORY_ICONS/CATEGORY_ICON_ORDER above), but for this
  // specific event rather than aggregated across the whole era, shown as
  // an inline superscript badge right after the sticky title text.
  const eventCategories = CATEGORY_ICON_ORDER.filter(cat => getEventCategories(event, era).includes(cat));
  const categoryIconsHtml = eventCategories.length ? `
    <span class="em-event-cats" aria-hidden="true">
      ${eventCategories.map(cat => `<span class="em-event-cat-icon em-event-cat-icon--${cat}">${CATEGORY_ICONS[cat]}</span>`).join('')}
