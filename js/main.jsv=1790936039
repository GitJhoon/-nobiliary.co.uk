  dom.modalTitle.innerHTML = escapeHtml(event.title) + categoryIconsHtml;

  const raw = event.detail || event.text || '';
  const paragraphs = raw
    .split('\n\n')
    .filter(p => p.trim())
    .map(p => `<p>${escapeHtml(p.trim())}</p>`)
    .join('') || `<p>${escapeHtml(raw)}</p>`;
  const whyItMatters = event.whyItMatters ? `
    <section class="em-why" aria-labelledby="em-why-heading">
      <h3 id="em-why-heading">Why it matters</h3>
      <p>${escapeHtml(event.whyItMatters)}</p>
    </section>` : '';

  const images = normaliseEventImages(event);
  const gallery = images.length ? `
    <div class="modal-gallery" aria-label="Event images">
      ${images.map((image, index) => `
        <button class="modal-gallery-item" type="button" data-gallery-index="${index}" aria-label="Expand ${escapeHtml(image.alt)}">
          <img src="${escapeHtml(image.src)}" alt="${escapeHtml(image.alt)}" loading="lazy">
          <span class="modal-gallery-zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
        </button>
        ${image.caption ? `<span class="modal-gallery-caption">${escapeHtml(image.caption)}</span>` : ''}`).join('')}
    </div>` : '';

  const sources = getEventSources(event);
  const sourceLink = sources.length ? `
    <div class="modal-source">
      <div class="modal-source-links">
        <span class="modal-source-label"><span class="em-source-icon">${EM_ICON_BOOK}</span>Sources &amp; further reading</span>
