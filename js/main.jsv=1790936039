// "Meanwhile in Europe and the world" sidebar — a vertical timeline of the
// closest entries in data/world-events.json to the event's year. Purely
// supplementary context, so it's marked data-nosnippet and kept out of
// matchesSearch/eventMatchesSearch — it should never surface as, or be
// mistaken for, a site search result.
function emWorldEventsHtml(year) {
  const items = getWorldEventsForYear(year);
