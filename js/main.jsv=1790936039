/* ─────────────────────────────────────────
   SHARE MENU — one instance each in #modal, .rp-panel and .ag-panel.
   The URL is always read live from the address bar rather than computed
   here, since every route that opens one of these already calls
   setLocationPath() to give itself a real, shareable address before (or
   as) it opens — see openModal/openRulerProfileModal/activateNavKey.
───────────────────────────────────────── */
const shareMenus = [];

function closeShareMenu(btn, menu) {
  if (!btn || !menu || menu.hidden) return;
  menu.hidden = true;
  btn.classList.remove('is-open');
  btn.setAttribute('aria-expanded', 'false');
}

function closeAllShareMenus() {
  shareMenus.forEach(({ btn, menu }) => closeShareMenu(btn, menu));
}

function openShareMenu(btn, menu) {
  const url = window.location.href;
  const title = getCurrentPageLabel();
  const targets = {
    facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url),
    x:        'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title),
    linkedin: 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url),
    email:    'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(url),
  };
  Object.keys(targets).forEach(key => {
    const link = menu.querySelector(`[data-share-action="${key}"]`);
    if (link) link.href = targets[key];
  });
  menu.hidden = false;
  btn.classList.add('is-open');
  btn.setAttribute('aria-expanded', 'true');
}

// Falls back to a hidden-textarea + execCommand('copy') on browsers/contexts
// without the async Clipboard API (e.g. non-HTTPS local dev over plain
// http://localhost, where navigator.clipboard is unavailable).
function copyTextToClipboard(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    return navigator.clipboard.writeText(text);
  }
  return new Promise((resolve, reject) => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      document.execCommand('copy') ? resolve() : reject(new Error('execCommand failed'));
    } catch (err) {
      reject(err);
    } finally {
      document.body.removeChild(ta);
    }
  });
}

function handleShareCopy(item) {
  const tag = item.querySelector('.share-copied-tag');
  copyTextToClipboard(window.location.href).then(() => {
    if (!tag) return;
    tag.hidden = false;
    clearTimeout(item._copyHideTimer);
    item._copyHideTimer = setTimeout(() => { tag.hidden = true; }, 1800);
  }).catch(() => {});
}

function bindShareMenu(wrap, btn, menu) {
  if (!wrap || !btn || !menu) return;
  shareMenus.push({ btn, menu });

  btn.addEventListener('click', e => {
    e.stopPropagation();
    const isOpen = !menu.hidden;
    closeAllShareMenus();
    if (!isOpen) openShareMenu(btn, menu);
  });

  menu.querySelectorAll('[data-share-action]').forEach(item => {
    if (item.dataset.shareAction === 'copy') {
      item.addEventListener('click', e => { e.preventDefault(); handleShareCopy(item); });
    } else {
      item.addEventListener('click', () => closeShareMenu(btn, menu));
    }
  });

  document.addEventListener('click', e => {
    if (!menu.hidden && !wrap.contains(e.target)) closeShareMenu(btn, menu);
  });
}

