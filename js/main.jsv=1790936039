/* ─────────────────────────────────────────
   MERGE same-year eras so each year appears
   only once in the scroll; sub-events are
   navigated via the pagination arrows.
───────────────────────────────────────── */
function mergeByYear(eras) {
  const map = new Map();
  for (const era of eras) {
    const events = era.events.map(event => ({
      ...event,
      categories: event.categories || (event.category ? [event.category] : era.categories || (era.category ? [era.category] : [])),
      tragic: event.tragic ?? era.tragic ?? false,
      sources: event.sources || era.sources || [],
      image: event.image || era.image,
      imageAttribution: event.imageAttribution || era.imageAttribution,
      location: event.location || era.location || '',
      type: event.type || era.type || '',
    }));
    if (map.has(era.year)) {
      map.get(era.year).events.push(...events);
    } else {
      map.set(era.year, { ...era, events });
    }
  }
  return [...map.values()];   // already chronological; Map preserves insertion order
}

// Data now flows through data.php (session-token gated — see .htaccess and
// data/.htaccess, which block direct requests to data/*.json) instead of
// being fetched as static files. Still exactly one request per file per
// page load; every modal/nav interaction after that stays in-memory.
const DATA_TOKEN = (document.querySelector('meta[name="data-token"]') || {}).content || '';
function fetchData(file) {
  return fetch(`data.php?file=${file}`, { headers: { 'X-Data-Token': DATA_TOKEN } })
    .then(r => { if (!r.ok) throw new Error(`Cannot load ${file}`); return r.json(); });
}

Promise.all([
  fetchData('events'),
  fetchData('rulers'),
  fetchData('world-events'),
  fetchData('timeline-maps'),
])
  .then(([eventsData, rulersData, worldEventsData, timelineMapsData]) => {
    state.eras = [
      { id: '__intro__', isIntro: true, year: null, label: 'WELCOME', eraName: 'Welcome',
        events: [], image: 'img/british-history-intro.webp', gradient: '#000', mapScale: 0, imageAttribution: null },
      ...mergeByYear(eventsData.eras),
    ];
    RULERS = rulersData;
    WORLD_EVENTS = worldEventsData;
    TIMELINE_MAPS = timelineMapsData.slice().sort((a, b) => a.year - b.year);
    init();
  })
  .catch(err => {
    document.body.innerHTML = `<div style="color:#c9a844;padding:48px;font-family:Georgia;font-size:18px;">
      Failed to load timeline data.<br><small style="color:#666">${err.message}</small>
    </div>`;
  });

function init() {
  // Disable the scroll-driver height; we use wheel events for navigation
  if (dom.scrollDriver) dom.scrollDriver.style.height = '0';

  buildTimelineWindow(0);
  buildEraNav();
  addScrollHint();
  bindEvents();
  activateEra(0, false);
  updateOrderArrows();
  buildSlugMaps();
  // One-time shim for the old #timeline/#rulers/#map/#legacy/#bibliography/
  // #about hash links (pre-migration to real paths) — the server never sees
  // the hash, so this only ever needs handling client-side, once, on boot.
  if ((currentRoutePath() === '/' || currentRoutePath() === '') && PATH_TO_NAV_KEY[window.location.hash.replace(/^#/, '')]) {
    history.replaceState(null, '', BASE_PATH + '/' + window.location.hash.replace(/^#/, ''));
  }
  routeFromPath();
  // Direct event URLs ship a server-rendered modal before the client-side
  // router runs; initialise its progressive source list as well.
  initModalSourceSlider(dom.modalBody);

  // updateEraNav() centers the active chip using its measured offsetLeft/
  // offsetWidth — if the webfont (Source Sans 3) hasn't finished loading
  // yet, those measurements are based on the fallback font's metrics, and
  // the resulting translateX can be off far enough to scroll every chip
  // out of the nav's masked viewport once the real font swaps in and
  // reflows the text. Re-run once fonts are actually ready to fix that.
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => updateEraNav());
  }
}

/* ─────────────────────────────────────────
   ERA CATEGORISATION
───────────────────────────────────────── */
function inferEventCategories(name) {
  const categories = [];
  if (/\b(battle|war|siege|raid|campaign|crusade|invasion|occupation|conflict|massacre|uprising|revolt|mutiny|skirmish)\b/i.test(name)) categories.push('battle');
  if (/\b(death|dies|assassinat|elect|coronat|inherit|seize|succession|abdicate|throne|regent|president|impeach|coup)\b|begins.*(rule|reign)/i.test(name)) categories.push('ruler-change');
  return categories;
}

function getEventCategories(event, era = {}) {
  const explicit = event.categories || (event.category ? [event.category] : []);
  if (explicit.length) return explicit;
  return inferEventCategories(event.title || era.eraName || '');
}

function getEraCategories(era) {
  const categories = new Set(era.categories || (era.category ? [era.category] : []));
  (era.events || []).forEach(event => getEventCategories(event, era).forEach(category => categories.add(category)));
  return [...categories];
}

function narrowEraForCategory(era, category) {
  const matchingEvents = (era.events || []).filter(event => getEventCategories(event, era).includes(category));
  if (!matchingEvents.length || matchingEvents.length === era.events.length) return era;
  return { ...era, events: matchingEvents, eraName: matchingEvents[0].title };
}

/* ─────────────────────────────────────────
   ORDERED ERA LIST
───────────────────────────────────────── */
// Strips diacritics (NFD-decomposes, then drops the combining marks) so
// searches match names with or without diacritics.
function normalizeSearchText(value) {
  return String(value || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
}

function eventMatchesSearch(ev, lq) {
  return (ev.title && normalizeSearchText(ev.title).includes(lq))
    || (ev.subtitle && normalizeSearchText(ev.subtitle).includes(lq))
    || (ev.text && normalizeSearchText(ev.text).includes(lq));
}

function matchesSearch(era, q) {
  const lq = normalizeSearchText(q);
  if (String(era.year).includes(lq)) return true;
  if (era.eraName && normalizeSearchText(era.eraName).includes(lq)) return true;
  if (era.label && normalizeSearchText(era.label).includes(lq)) return true;
  return (era.events || []).some(ev => eventMatchesSearch(ev, lq));
}

// Same-year eras are merged into one timeline entry (see mergeByYear) — a
// query that matches only one of several sub-events would otherwise still
// surface every event for that year in the results. Narrow `events` down to
// just the matches. A bare year query (e.g. "1340") still shows the whole
// year, and a query that only matches era-level metadata (the dynasty
// label) with no per-event match falls back to showing every event, since
// there's nothing more specific to narrow to.
function narrowEraForSearch(era, q) {
  const lq = normalizeSearchText(q);
  if (String(era.year).includes(lq)) return era;

  const matchingEvents = (era.events || []).filter(ev => eventMatchesSearch(ev, lq));
  if (!matchingEvents.length || matchingEvents.length === era.events.length) return era;
  return { ...era, events: matchingEvents, eraName: matchingEvents[0].title };
}

function getOrderedEras() {
  const intro = state.eras.find(e => e.isIntro);
  let eras = (state.order === 'asc' ? [...state.eras] : [...state.eras].reverse())
    .filter(e => !e.isIntro);
  if (state.filter !== 'all') {
    eras = eras.filter(era => getEraCategories(era).includes(state.filter))
      .map(era => narrowEraForCategory(era, state.filter));
  }
  if (state.search) {
    eras = eras.filter(era => matchesSearch(era, state.search))
      .map(era => narrowEraForSearch(era, state.search));
  }
  if (intro && state.filter === 'all' && !state.search) eras.unshift(intro);
  return eras;
}

/* ─────────────────────────────────────────
   WINDOWED TIMELINE DOM
   Only renders ±WINDOW_HALF items around active
───────────────────────────────────────── */
function buildTimelineWindow(activeIndex, previousIndex = activeIndex) {
  const ordered = getOrderedEras();
  const total   = ordered.length;
  const start   = Math.max(0, activeIndex - WINDOW_HALF);
  const end     = Math.min(total - 1, activeIndex + WINDOW_HALF);

  const classFor = (g, refIndex) => {
    const dist = Math.abs(g - refIndex);
    return dist === 0 ? 'active' : dist <= 2 ? 'near' : 'far';
  };

  // Items are rebuilt from scratch every step, so a freshly created element
  // has no "before" state to transition from — its active/near/far class is
  // just baked in at creation, and the year number snaps straight to its
  // final size/color instead of animating. To fix that, paint the *previous*
  // active position first (when it's still in view), then flip every item to
  // its real class on the next frame so the CSS transitions on .tl-year/
  // .tl-dot have something to interpolate from.
  const canAnimate = previousIndex !== activeIndex && previousIndex >= start && previousIndex <= end;
  const initialRef = canAnimate ? previousIndex : activeIndex;

  dom.tlItems.innerHTML = '';

  for (let g = start; g <= end; g++) {
    const era  = ordered[g];

    const el = document.createElement('div');
    el.className  = 'tl-item ' + classFor(g, initialRef);
    el.dataset.globalIndex = g;
    el.setAttribute('role', 'listitem');
    if (era.isIntro) {
      el.classList.add('is-intro');
      el.innerHTML = `
        <div class="tl-dot" aria-hidden="true"></div>
        <div class="tl-label">
          <span class="tl-era">${era.eraName}</span>
        </div>`;
    } else {
      const badge = era.events.length > 1
        ? `<span class="tl-event-count">${era.events.length}</span>`
        : '';
      const categoryIcons = CATEGORY_ICON_ORDER
        .filter(cat => getEraCategories(era).includes(cat))
        .map(cat => `<span class="tl-cat-icon tl-cat-icon--${cat}">${CATEGORY_ICONS[cat]}</span>`)
        .join('');
      el.innerHTML = `
        <div class="tl-dot" aria-hidden="true"></div>
        <div class="tl-label">
          <span class="tl-year-row">
            <span class="tl-year-wrap"><span class="tl-year">${era.year}</span></span>
            <span class="tl-year-badges">${badge}${categoryIcons}</span>
          </span>
          <span class="tl-era">${era.eraName}</span>
        </div>`;
    }
    el.addEventListener('click', () => goToEra(g));
    dom.tlItems.appendChild(el);
  }

  positionTimeline(activeIndex, start);
  updateEraIndicator(activeIndex, ordered);

  if (canAnimate) {
    requestAnimationFrame(() => requestAnimationFrame(() => {
      dom.tlItems.querySelectorAll('.tl-item[data-global-index]').forEach(el => {
        el.classList.remove('active', 'near', 'far');
        el.classList.add(classFor(Number(el.dataset.globalIndex), activeIndex));
      });
    }));
  }
}

/* ─────────────────────────────────────────
   POSITION TIMELINE (translate to center active)
───────────────────────────────────────── */
function positionTimeline(activeIndex, windowStart) {
  const track = document.getElementById('timeline-track');

  // The timeline is a vertical column at every breakpoint (see the matching
  // @media (max-width:760px) block in style.css, which just scales the item
  // heights down for the narrower mobile column). Below the mobile
  // breakpoint, item heights shrink from 78/110 to 58/82 — keep these in
  // sync with --tl-item-h and .tl-item.active's height there.
  const isMobile = window.matchMedia('(max-width:760px)').matches;
  const defH = isMobile ? 58 : 78;
  const actH = isMobile ? 82 : 110;

  // Represent items above the rendered window so the container has a global
  // coordinate system — translateY then changes by defH on every step,
  // giving a consistent slide animation regardless of window position.
  dom.tlItems.style.paddingLeft = '0';
  dom.tlItems.style.paddingTop  = `${windowStart * defH}px`;

  if (isMobile) {
    // On mobile the active item's number sits near the top of its row (see
    // .tl-item.active .tl-label in style.css), so anchor that top edge near
    // the track's own top instead of vertically centering it — this lines
    // the active year up with the event title in the content column beside
    // it, rather than the middle of the screen.
    const MOBILE_ANCHOR = 109;
    const offsetY = activeIndex * defH;
    dom.tlItems.style.transform = `translateY(${MOBILE_ANCHOR - offsetY}px)`;
    return;
  }

  const offsetY = activeIndex * defH + actH / 2;
  const trackH  = track ? track.offsetHeight : window.innerHeight - 120;
  dom.tlItems.style.transform = `translateY(${(trackH / 2) - offsetY}px)`;
}

/* ─────────────────────────────────────────
   ERA INDICATOR (static gold marker naming the active era)
   Deliberately does no position math — the element fills a fixed box (see
   .era-indicator in style.css) so it never moves as you scroll; only the
   label text and visibility change here. Skipped on mobile, where the
   ruler-card gap this marker lives in doesn't exist (see the
   max-width:760px CSS override).
───────────────────────────────────────── */
let eraIndicatorSwapTimer = null;
function updateEraIndicator(activeIndex, ordered) {
  const el = dom.eraIndicator;
  if (!el) return;

  const era = ordered[activeIndex];
  const isMobile = window.matchMedia('(max-width:760px)').matches;
  if (isMobile || !era || era.isIntro || !era.label || state.filter !== 'all' || state.search) {
    el.classList.remove('is-visible');
    return;
  }

  const labelEl = dom.eraIndicatorLabel;
  if (labelEl && labelEl.textContent !== era.label) {
    // Fades the old label out, swaps the text once it's invisible, then
    // lets the same CSS transition fade/scale the new text back in —
    // clearTimeout guards against a fast run of era changes (rapid wheel
    // scroll) leaving a stale swap to land after a later one.
    labelEl.classList.add('is-swapping');
    clearTimeout(eraIndicatorSwapTimer);
    eraIndicatorSwapTimer = setTimeout(() => {
      labelEl.textContent = era.label;
      labelEl.classList.remove('is-swapping');
    }, 160);
  }
  el.classList.add('is-visible');
}

/* ─────────────────────────────────────────
   ACTIVATE ERA
───────────────────────────────────────── */
function activateEra(index, animate) {
  const previousIndex = state.activeEra;
  state.activeEra   = index;
  state.activeEvent = 0;

  const ordered = getOrderedEras();
  const era = ordered[index];
  if (!era) return;

  if (index >= 3 && dom.scrollHint && !dom.scrollHint.classList.contains('hidden')) {
    dom.scrollHint.classList.add('hidden');
  }

  // On mobile, #content-panel scrolls independently of the page — without
  // this, switching eras while scrolled down into a long event (or the
  // succession block below it) left the new card's top cut off behind the
  // fixed search/era-nav bars instead of starting fresh at the top.
  if (dom.contentPanel) dom.contentPanel.scrollTop = 0;

  buildTimelineWindow(index, previousIndex);

  if (era.isIntro) {
    document.body.classList.add('intro-mode');
    dom.eventBlock.hidden = true;
    if (dom.introBlock) dom.introBlock.hidden = false;
    dom.eventNav.style.visibility = 'hidden';
    dom.rulerCard.classList.add('ruler-fade');
    state.activeRulerIdx = -1;
    if (animate && dom.introBlock) {
      dom.introBlock.classList.add('content-fade-out');
      setTimeout(() => dom.introBlock.classList.remove('content-fade-out'), 310);
    }
    updateEventVisual(era, 0, animate);
    updateArrows(index, ordered.length);
    updateMap(era);
    updateProgress(index, ordered.length);
    updateEraNav();
    renderSuccession(era);
    return;
  }

  document.body.classList.remove('intro-mode');

  if (dom.introBlock) {
    if (!dom.introBlock.hidden) dom.eventBlock.classList.add('content-fade-out');
    dom.introBlock.hidden = true;
  }
  dom.eventBlock.hidden = false;

  updateEventVisual(era, 0, animate);
  updateContent(era, 0, animate);
  updateArrows(index, ordered.length);
  updateMap(era);
  updateProgress(index, ordered.length);
  updateRulerCard(era, animate);
  updateEraNav();
  renderSuccession(era);
}

/* ─────────────────────────────────────────
   GO TO ERA (instant or smooth)
───────────────────────────────────────── */
function goToEra(index) {
  const total = getOrderedEras().length;
  const clamped = Math.max(0, Math.min(total - 1, index));
  activateEra(clamped, true);
}

/* ─────────────────────────────────────────
   BACKGROUND CROSSFADE
───────────────────────────────────────── */
function updateBackground(era, animate) {
  const layerIn  = state.bgActive === 'a' ? dom.bgA : dom.bgB;
  const layerOut = state.bgActive === 'a' ? dom.bgB : dom.bgA;

  applyBgStyle(layerIn, era);

  if (animate) {
    layerIn.classList.remove('active', 'fadeout');
    layerIn.classList.add('active');
    layerOut.classList.remove('active');
    layerOut.classList.add('fadeout');
  } else {
    layerIn.classList.add('active');
    layerOut.classList.remove('active', 'fadeout');
  }

  state.bgActive = state.bgActive === 'a' ? 'b' : 'a';
}

function updateEventVisual(era, eventIndex, animate) {
  const event = era.events[eventIndex] || {};
  updateBackground({ ...era, image: event.image || era.image }, animate);
  updateImageCredit(event.imageAttribution || era.imageAttribution);
}

function updateImageCredit(credit) {
  if (!dom.imageCredit || !credit) {
    if (dom.imageCredit) dom.imageCredit.hidden = true;
    return;
  }
  dom.creditSource.textContent = credit.title || 'View source';
  dom.creditSource.href = credit.sourceUrl || '#';
  dom.creditCreator.textContent = credit.creator ? ` — ${credit.creator}` : '';
  dom.creditProvider.textContent = credit.provider ? ` · ${credit.provider}` : '';
  dom.creditLicense.textContent = credit.license || '';
  dom.creditLicense.href = credit.licenseUrl || credit.sourceUrl || '#';
  dom.creditLicense.hidden = !credit.license;
  dom.imageCredit.title = credit.usageNote || '';
  dom.imageCredit.hidden = false;
}

function applyBgStyle(layer, era) {
  if (era.image) {
    layer.style.backgroundImage    = `url('${era.image}')`;
    layer.style.backgroundSize     = 'cover';
    layer.style.backgroundPosition = 'center top';
    layer.style.backgroundColor    = '#050308';
  } else {
    layer.style.backgroundImage = 'none';
    layer.style.background      = era.gradient;
  }
}

/* ─────────────────────────────────────────
   CONTENT PANEL
───────────────────────────────────────── */
function updateContent(era, eventIndex, animate) {
  const event = era.events[eventIndex];
  if (!event) return;

  const apply = () => {
    updateFilterBanner();
    // Same inline superscript category badge as the event modal's title
    // (.em-event-cats / CATEGORY_ICON_ORDER / CATEGORY_ICONS) — innerHTML
    // instead of textContent so the badge markup can ride along after the
    // (escaped) title text.
    const eventCategories = CATEGORY_ICON_ORDER.filter(cat => getEventCategories(event, era).includes(cat));
    const categoryIconsHtml = eventCategories.length ? `
      <span class="em-event-cats" aria-hidden="true">
        ${eventCategories.map(cat => `<span class="em-event-cat-icon em-event-cat-icon--${cat}">${CATEGORY_ICONS[cat]}</span>`).join('')}
      </span>` : '';
    dom.contentHeading.innerHTML = `${escapeHtml(event.title)}${categoryIconsHtml}`;
    dom.eventSubtitle.textContent  = (event.subtitle || '').replace(/^.*? — /, '');
    // The timeline is a compact preview. Full multi-paragraph copy remains
    // available in the event modal.
    dom.eventText.textContent      = String(event.text || '').split(/\n\s*\n/)[0].trim();
    document.body.classList.toggle('tragic', !!event.tragic);

    const thumb = event.image || era.image;
    if (dom.eventCardMedia && dom.eventCardImg) {
      dom.eventCardMedia.classList.toggle('is-empty', !thumb);
      if (thumb) {
        dom.eventCardImg.src = thumb;
        dom.eventCardImg.alt = event.title || '';
      }
    }

    const total = era.events.length;
    dom.pagDisplay.textContent        = `${eventIndex + 1} OF ${total}`;
    dom.eventNav.style.visibility     = total > 1 ? 'visible' : 'hidden';
    dom.prevEvent.disabled            = eventIndex === 0;
    dom.nextEvent.disabled            = eventIndex === total - 1;
  };

  if (animate) {
    dom.eventBlock.classList.add('content-fade-out');
    setTimeout(() => {
      apply();
      dom.eventBlock.classList.remove('content-fade-out');
    }, 310);
  } else {
    apply();
  }
}

function updateArrows() { /* direction arrows don't disable; order-active class handles state */ }

// Corner map (bottom-right, fixed size/position) — crossfades to the latest
// TIMELINE_MAPS entry whose year has been reached by the active era's year
// (never a future-dated map), same lookup and crossfade technique as the
// Map modal's stage (see nearestMapEntry / setMapYear). The intro era has
// no year, so it's left untouched — the whole container is already hidden
// via body.intro-mode.
let cornerMapActive = 'a';
let cornerMapFile = null;

function updateMap(era) {
  if (era.year == null) return;
  const entry = nearestMapEntry(era.year);
  if (!entry || entry.file === cornerMapFile) return;
  cornerMapFile = entry.file;

  const layerIn  = cornerMapActive === 'a' ? dom.mapLayerA : dom.mapLayerB;
  const layerOut = cornerMapActive === 'a' ? dom.mapLayerB : dom.mapLayerA;
  if (!layerIn) return;

  layerIn.style.backgroundImage = `url('${entry.file}')`;
  layerIn.classList.remove('fadeout');
  layerIn.classList.add('active');
  if (layerOut) { layerOut.classList.remove('active'); layerOut.classList.add('fadeout'); }
  cornerMapActive = cornerMapActive === 'a' ? 'b' : 'a';
}


function updateProgress(index, total) {
  const pct = total > 1 ? (index / (total - 1)) * 100 : 0;
  dom.progressBar.style.width = `${pct}%`;
}

/* ─────────────────────────────────────────
   EVENT PAGINATION (within era)
───────────────────────────────────────── */
function navigateEvent(dir) {
  const era  = getOrderedEras()[state.activeEra];
  if (!era) return;
  const next = state.activeEvent + dir;
  if (next < 0 || next >= era.events.length) return;
  state.activeEvent = next;
  updateContent(era, next, true);
  updateEventVisual(era, next, true);
}

/* ─────────────────────────────────────────
   ORDER TOGGLE
───────────────────────────────────────── */
function toggleOrder() {
  setOrder(state.order === 'asc' ? 'desc' : 'asc');
}

function setOrder(newOrder) {
  state.order = newOrder;
  if (dom.orderLabel) dom.orderLabel.textContent = newOrder === 'asc' ? 'OLDEST FIRST' : 'NEWEST FIRST';
  updateOrderArrows();
  activateEra(0, true);   // ↓ → index 0 = oldest;  ↑ → index 0 = newest
}

function updateOrderArrows() {
  dom.orderAsc.classList.toggle('order-active',  state.order === 'asc');
  dom.orderDesc.classList.toggle('order-active', state.order === 'desc');
}

/* ─────────────────────────────────────────
   FILTER
───────────────────────────────────────── */
function setFilter(newFilter) {
  state.filter = newFilter;
  updateFilterUI();
  activateEra(0, true);
}

function setSearch(q) {
  state.search = q.trim();
  if (dom.searchWrap) dom.searchWrap.classList.toggle('has-query', !!state.search);
  if (dom.searchClear) dom.searchClear.hidden = !state.search;
  activateEra(0, true);
}

// Reads state.search/state.filter and shows a disclaimer above the event
// title whenever the timeline is narrowed — otherwise it's easy to forget a
// search or category filter is active and wonder why so few events appear.
function updateFilterBanner() {
  if (!dom.filterBanner) return;
  const hasSearch = !!state.search;
  const hasFilter = state.filter !== 'all';
  if (!hasSearch && !hasFilter) { dom.filterBanner.hidden = true; return; }

  const parts = [];
  if (hasFilter) parts.push(`category "${FILTER_READABLE[state.filter] || state.filter}"`);
  if (hasSearch) parts.push(`search phrase "${state.search}"`);
  dom.filterBannerText.textContent = `Events filtered by ${parts.join(' and ')}.`;
  dom.filterBanner.hidden = false;
}

// Shared by the banner's "Remove filter" link and any other spot that needs
// to fully reset both narrowing mechanisms at once.
function clearSearchAndFilter() {
  state.search = '';
  state.filter = 'all';
  if (dom.searchInput) dom.searchInput.value = '';
  if (dom.searchWrap) dom.searchWrap.classList.remove('has-query');
  if (dom.searchClear) dom.searchClear.hidden = true;
  updateFilterUI();
  activateEra(0, true);
}

function updateFilterUI() {
  if (dom.filterLabel) dom.filterLabel.textContent = FILTER_LABELS[state.filter] || 'All';
  document.querySelectorAll('.filter-option').forEach(opt => {
    const active = opt.dataset.filter === state.filter;
    opt.classList.toggle('active', active);
    opt.setAttribute('aria-selected', String(active));
  });
}

/* ─────────────────────────────────────────
   ERA NAVIGATION PANEL
───────────────────────────────────────── */
function buildEraNav() {
  const seen = new Set();
  state.uniqueEraLabels = [];
  for (const era of state.eras) {
    if (era.isIntro) continue;
    if (!seen.has(era.label)) {
      seen.add(era.label);
      state.uniqueEraLabels.push(era.label);
    }
  }

  dom.eraNavInner.innerHTML = '';
  for (const label of state.uniqueEraLabels) {
    const btn = document.createElement('button');
    btn.className   = 'era-nav-item';
    btn.textContent = label;
    btn.dataset.eraLabel = label;
    btn.addEventListener('click', () => {
      const ordered = getOrderedEras();
      const idx = ordered.findIndex(e => e.label === label);
      if (idx !== -1) goToEra(idx);
    });
    dom.eraNavInner.appendChild(btn);
  }
}

function updateEraNav() {
  const ordered     = getOrderedEras();
  const activeLabel = ordered[state.activeEra]?.label;
  let activeBtn     = null;

  dom.eraNavInner.querySelectorAll('.era-nav-item').forEach(btn => {
    const isActive = btn.dataset.eraLabel === activeLabel;
    btn.classList.toggle('active', isActive);
    if (isActive) activeBtn = btn;
  });

  if (!activeBtn) return;
  requestAnimationFrame(() => {
    const navW   = dom.eraNav.offsetWidth;
    const btnW   = activeBtn.offsetWidth;
    // #era-nav is `position:fixed`, so its width shouldn't legitimately be
    // 0 — but if this runs before the browser's first real layout pass
    // (e.g. a very early document.fonts.ready resolution), offsetWidth can
    // momentarily read 0, which would compute a huge bogus shift and throw
    // every chip off-screen. Bail and retry next frame instead of trusting
    // that measurement — this is what caused chips to render correctly
    // once, then jump off-screen a moment later.
    if (navW === 0 || btnW === 0) {
      requestAnimationFrame(() => updateEraNav());
      return;
    }
    const btnLeft = activeBtn.offsetLeft;
    const shift  = navW / 2 - btnLeft - btnW / 2;
    dom.eraNavInner.style.transform = `translateX(${shift}px)`;
  });
}

/* ─────────────────────────────────────────
   RULER CARD
───────────────────────────────────────── */
function getRuler(year) {
  let result = RULERS[0];
  for (const r of RULERS) {
    if (year < r.from) break;
    if (year <= (r.to ?? year)) result = r;
  }
  return result;
}

function applyRuler(ruler) {
  dom.rulerName.textContent    = ruler.name;
  dom.rulerTitleEl.textContent = ruler.title;
  dom.rulerReign.textContent   = `${ruler.reignLabel || 'Reign'}: ${ruler.reign}`;
  dom.rulerCrownIcon.hidden    = !ruler.isKing;
  const useImperialPlaceholder = !ruler.image && ruler.reign.includes('Russian Empire');
  dom.rulerPortraitPh.classList.toggle('is-imperial', useImperialPlaceholder);

  if (ruler.image) {
    dom.rulerImg.hidden  = true;
    dom.rulerImg.onload  = () => { dom.rulerImg.hidden = false; };
    dom.rulerImg.onerror = () => {};
    dom.rulerImg.alt     = `Portrait of ${ruler.name}`;
    dom.rulerImg.src     = ruler.image;
    if (dom.rulerImg.complete) dom.rulerImg.hidden = false;
    dom.rulerPortraitPh.style.display = 'none';
  } else {
    dom.rulerImg.hidden  = true;
    dom.rulerImg.onload  = null;
    dom.rulerImg.onerror = null;
    dom.rulerPortraitPh.style.display = '';
  }

  renderAdjacentRulers(RULERS.indexOf(ruler));
}

// Populates the "Previous" / "Next" mini-lists flanking the active ruler
// card — up to two neighbours on each side, nearest neighbour closest to
// the active card so the whole block reads chronologically top to bottom.
function renderAdjacentRulers(idx) {
  const itemHtml = r => `
    <div class="rs-adjacent-item">
      <span class="rs-adjacent-dot"></span>
      <div class="rs-adjacent-text">
        <span class="rs-adjacent-name">${r.name}</span>
        <span class="rs-adjacent-years">${r.reign}</span>
      </div>
    </div>`;

  const previous = [RULERS[idx - 2], RULERS[idx - 1]].filter(Boolean);
  dom.rulerPrevious.innerHTML = previous.map(itemHtml).join('');

  const next = [RULERS[idx + 1], RULERS[idx + 2]].filter(Boolean);
  dom.rulerNext.innerHTML = next.map(itemHtml).join('');
}

// Dynasty ids (DYNASTIES' keys, e.g. "jagiellonian") are internal and don't
// always read naturally in a URL — the hash uses a slug of the dynasty's
// display label instead (e.g. "jagiellonians"), resolved back to an id on
// load by dynastyIdFromSlug.
function dynastySlug(id) {
  const d = DYNASTIES[id];
  return d ? slugify(d.label) : slugify(id);
}
function dynastyIdFromSlug(slug) {
  return Object.keys(DYNASTIES).find(id => dynastySlug(id) === slug) || null;
}

// "View Full Dynasty" — jumps to the Rulers & Dynasties page with the same
// dynasty highlighted as if its label/legend entry had been clicked there.
function viewFullDynasty(ruler) {
  if (!ruler || !ruler.dynasty) return;
  openRulersPage();
  setRpTab('all');
  setRpDynastyFilter(ruler.dynasty);
  document.querySelectorAll('.nav-link').forEach(x => x.classList.remove('active'));
  const rdLink = document.querySelector('.nav-link[data-nav="rulers-dynasties"]');
  if (rdLink) rdLink.classList.add('active');
  setLocationPath('/rulers', dynastySlug(ruler.dynasty));
}

const RS_SLIDE_CLASSES = ['rs-slide-out-up', 'rs-slide-out-down', 'rs-slide-in-up', 'rs-slide-in-down'];

function updateRulerCard(era, animate) {
  const ruler   = getRuler(era.year);
  const newIdx  = RULERS.indexOf(ruler);
  if (newIdx === state.activeRulerIdx) return;
  const prevIdx = state.activeRulerIdx;
  state.activeRulerIdx = newIdx;

  const shouldHide = ruler.hide === true;

  if (animate) {
    dom.rulerCard.classList.remove(...RS_SLIDE_CLASSES);
    if (shouldHide) {
      dom.rulerCard.classList.add('ruler-fade');
      return;
    }
    // Slide the whole card in the direction of travel through history —
    // forward (later years) reads as content rising up, backward as it
    // settling down — instead of the plain crossfade used for the
    // hidden/interregnum state above.
    const backward = prevIdx !== -1 && newIdx < prevIdx;
    const outClass = backward ? 'rs-slide-out-down' : 'rs-slide-out-up';
    const inClass  = backward ? 'rs-slide-in-down'  : 'rs-slide-in-up';
    dom.rulerCard.classList.remove('ruler-fade');
    dom.rulerCard.classList.add(outClass);
    setTimeout(() => {
      applyRuler(ruler);
      dom.rulerCard.classList.remove(outClass);
      dom.rulerCard.classList.add(inClass);
      void dom.rulerCard.offsetWidth; // force reflow so the "in" start position applies before animating
      requestAnimationFrame(() => dom.rulerCard.classList.remove(inClass));
    }, 300);
  } else {
    dom.rulerCard.classList.remove(...RS_SLIDE_CLASSES);
    if (shouldHide) {
      dom.rulerCard.classList.add('ruler-fade');
    } else {
      applyRuler(ruler);
      dom.rulerCard.classList.remove('ruler-fade');
    }
  }
}

// Mobile-only "Succession / Administration" list — shows only the ruler
// active during the current era, reusing the same RULERS ordering as the
// desktop ruler card (see getRuler/applyRuler above).
function renderSuccession(era) {
  if (!dom.successionBlock || !dom.successionList) return;

  if (era.isIntro) {
    dom.successionBlock.hidden = true;
    return;
  }

  const activeRuler = getRuler(era.year);
  const idx   = RULERS.indexOf(activeRuler);
  const items = [RULERS[idx]].filter(Boolean);

  if (!items.length) {
    dom.successionBlock.hidden = true;
    return;
  }

  dom.successionBlock.hidden = false;
  dom.successionList.innerHTML = items.map((r, i) => {
    const portrait = r.image
      ? `<img src="${r.image}" alt="Portrait of ${r.name}">`
      : `<img class="succession-portrait-ph" src="img/logo.svg" alt="">`;
    return `
      <div class="succession-item ${i === 0 ? 'is-active' : ''}" data-ruler-idx="${RULERS.indexOf(r)}">
        <div class="succession-card">
          <div class="succession-portrait">${portrait}</div>
          <div class="succession-info">
            <span class="succession-name">${r.name}</span>
            <span class="succession-role">${r.title}</span>
            <span class="succession-period">Period: ${r.from} – ${r.to}</span>
          </div>
          <svg class="succession-chevron" viewBox="0 0 12 12" width="8" height="8" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>`;
  }).join('');

  dom.successionList.querySelectorAll('.succession-item').forEach(el => {
    el.addEventListener('click', () => {
      const ruler = RULERS[Number(el.dataset.rulerIdx)];
      if (ruler) openRulerProfileModal(ruler);
    });
  });
}

/* ─────────────────────────────────────────
   RULERS & DYNASTIES (full page)
───────────────────────────────────────── */
const RP_AXIS_MIN = -1000;

const RP_DYNASTY_ORDER = [
  'prehistoric', 'roman-britain', 'early-kingdoms', 'wessex', 'denmark',
  'godwin', 'norman', 'blois', 'plantagenet', 'lancaster', 'york', 'tudor',
  'tudor-claimant', 'stuart', 'commonwealth', 'protectorate', 'orange',
  'hanover', 'saxe-coburg-gotha', 'windsor',
];
// Reassigned by updateRpPageSize() once the row's real rendered width is
// known — .rp-avatar's width is fluid (see CSS), so a fixed count would
// either overflow on narrow screens or waste space on wide ones.
let RP_PAGE_SIZE = 12;

// `pageStart` is an absolute index into the current list (not a page
// number) so a dynasty highlight can center on any index, not just one
// that happens to land on a multiple of RP_PAGE_SIZE.
const rpState = { tab: 'all', search: '', pageStart: 0, dynastyFilter: null, lastAllStart: null, axisMin: null, axisMax: null, built: false };
let rpTooltipHideTimer = null;

function rpDynastyInfo(ruler) {
  return DYNASTIES[ruler.dynasty] || { label: ruler.dynasty || 'Unknown', color: '#888' };
}

// Most rulers belong to exactly one dynasty (`ruler.dynasty`), but a few —
// e.g. Jogaila, who founded the Jagiellonian line while still reigning as a
// Gediminid — belong to two. `ruler.dynasties`, when present, lists every
// dynasty that should highlight/count that ruler as a member; `ruler.dynasty`
// stays the single "primary" one used for the timeline run's color/band.
function rulerDynasties(ruler) {
  return ruler.dynasties || [ruler.dynasty];
}

function rpPortraitInner(ruler) {
  if (ruler.image) return `<img src="${ruler.image}" alt="Portrait of ${ruler.name}" loading="lazy">`;
  return `<svg class="rp-portrait-placeholder" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 20c1.2-4.2 4.4-6.5 8-6.5s6.8 2.3 8 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
}

function rpMatchesSearch(ruler, q) {
  if (!q) return true;
  const lq = normalizeSearchText(q);
  return normalizeSearchText(ruler.name).includes(lq)
    || normalizeSearchText(ruler.title).includes(lq)
    || rulerDynasties(ruler).some(id => normalizeSearchText((DYNASTIES[id] || {}).label || id).includes(lq));
}

function getRpList() {
  const q = rpState.search;
  switch (rpState.tab) {
    case 'grand-dukes':
      return RULERS.filter(r => /\b(King|Queen)\b/i.test(r.title) && rpMatchesSearch(r, q));
    case 'joint-rulers':
      return RULERS.filter(r => r.jointRule && rpMatchesSearch(r, q));
    case 'by-reign-length':
      // Exclude placeholder/period entries (pre-state era, administrative interregnums) —
      // they aren't individual reigns and would otherwise skew the ranking.
      return RULERS.filter(r => r.from > 0
          && r.reignLabel !== 'Period'
          && rpMatchesSearch(r, q)
          && (!rpState.dynastyFilter || rulerDynasties(r).includes(rpState.dynastyFilter)))
        .sort((a, b) => (b.to - b.from) - (a.to - a.from));
    default:
      return RULERS.filter(r => rpMatchesSearch(r, q));
  }
}

function renderRpLegend(dynastyIds, opts = {}) {
  dom.rpLegend.innerHTML = dynastyIds.map(id => {
    const d = DYNASTIES[id];
    const dot = `<span class="rp-legend-dot" style="background:${d.color}"></span>`;
    if (opts.clickable) {
      const activeClass = rpState.dynastyFilter === id ? ' is-active' : '';
      return `<button type="button" class="rp-legend-item is-clickable${activeClass}" data-dynasty="${id}" style="--legend-color:${d.color}">${dot}${d.label}</button>`;
    }
    return `<span class="rp-legend-item" style="--legend-color:${d.color}">${dot}${d.label}</span>`;
  }).join('');
}

// Renders year ticks, dynasty name labels (alternating above/below the line
// so adjacent runs never overlap), and the colored line + transition dots
// for the given [minYear, maxYear] window over `items` (chronological).
// When opts.clickable is set, labels become buttons that highlight that
// dynasty (used on the All Rulers tab).
function renderRpAxisAndTrack(minYear, maxYear, items, opts = {}) {
  const span = Math.max(1, maxYear - minYear);
  rpState.axisMin = minYear;
  rpState.axisMax = maxYear;
  rpHideRulerHighlight();

  const niceSteps = [10, 25, 50, 100, 200];
  const step = niceSteps.find(s => span / 6 <= s) || 250;
  const ticks = [];
  for (let y = Math.ceil(minYear / step) * step; y <= maxYear; y += step) ticks.push(y);
  if (ticks[0] !== minYear) ticks.unshift(minYear);
  if (ticks[ticks.length - 1] !== maxYear) ticks.push(maxYear);

  dom.rpAxisTicks.innerHTML = ticks.map(y => {
    const pct = ((y - minYear) / span) * 100;
    return `<span class="rp-axis-tick" style="left:${pct}%">${y}</span>`;
  }).join('');

  // Group consecutive same-dynasty rulers into a single run for the label + line segment.
  const runs = [];
  for (const r of items) {
    const last = runs[runs.length - 1];
    const end = r.to || r.from;
    if (last && last.dynasty === r.dynasty) {
      last.end = Math.max(last.end, end);
    } else {
      runs.push({ dynasty: r.dynasty, start: r.from, end });
    }
  }

  dom.rpDynastyLabels.innerHTML = runs.map((run, i) => {
    const d = DYNASTIES[run.dynasty] || { label: run.dynasty, color: '#888' };
    const startPct  = ((Math.max(run.start, minYear) - minYear) / span) * 100;
    const endPct    = ((Math.min(run.end, maxYear) - minYear) / span) * 100;
    const centerPct = (startPct + endPct) / 2;
    const posClass  = i % 2 === 0 ? 'rp-dynasty-label--top' : 'rp-dynasty-label--bottom';
    if (opts.clickable) {
      const activeClass = rpState.dynastyFilter === run.dynasty ? ' is-active' : '';
      return `<button type="button" class="rp-dynasty-label is-clickable ${posClass}${activeClass}" data-dynasty="${run.dynasty}" style="left:${centerPct}%; color:${d.color}">${d.label}</button>`;
    }
    return `<span class="rp-dynasty-label ${posClass}" style="left:${centerPct}%; color:${d.color}">${d.label}</span>`;
  }).join('');

  const segHtml = runs.map(run => {
    const d     = DYNASTIES[run.dynasty] || { color: '#888' };
    const left  = ((Math.max(run.start, minYear) - minYear) / span) * 100;
    const width = ((Math.min(run.end, maxYear) - Math.max(run.start, minYear)) / span) * 100;
    return `<div class="rp-segment" style="left:${left}%; width:${Math.max(width, 0.5)}%; background:${d.color}"></div>`;
  }).join('');

  const dotHtml = items.filter(r => r.from > minYear && r.from < maxYear).map(r => {
    const left = ((r.from - minYear) / span) * 100;
    return `<span class="rp-transition-dot" style="left:${left}%"></span>`;
  }).join('');

  dom.rpAxisBar.innerHTML = segHtml + dotHtml;

  // Invisible-by-default per-ruler segments, thickened on avatar hover so a
  // visitor can see exactly where in the timeline that reign falls.
  dom.rpRulerTicks.innerHTML = items.map(r => {
    const start = Math.max(r.from, minYear);
    const end   = Math.max(Math.min(r.to || r.from, maxYear), start);
    const left  = ((start - minYear) / span) * 100;
    const width = ((end - start) / span) * 100;
    const color = rpDynastyInfo(r).color;
    return `<div class="rp-ruler-tick" data-idx="${RULERS.indexOf(r)}" style="left:${left}%; width:${Math.max(width, 0.4)}%; --rp-tick-color:${color}"></div>`;
  }).join('');
}

function rpAvatarHTML(ruler, opts = {}) {
  const idx = RULERS.indexOf(ruler);
  let ringColor = opts.ringColor;
  let dimmed = opts.dimmed;
  // On tabs with clickable dynasty labels (All Rulers, Grand Dukes, Joint
  // Rulers), a dynasty filter auto-highlights matching rulers and dims the
  // rest, unless the caller already specified explicitly.
  if (rpState.dynastyFilter && ringColor == null && dimmed == null) {
    const isMatch = rulerDynasties(ruler).includes(rpState.dynastyFilter);
    ringColor = isMatch ? DYNASTIES[rpState.dynastyFilter].color : null;
    dimmed = !isMatch;
  }
  const ringStyle = ringColor ? ` style="--rp-ring:${ringColor}"` : '';
  const dimClass = dimmed ? ' is-dimmed' : '';
  const dynasty = rpDynastyInfo(ruler);
  const reignYears = Math.max(0, (ruler.to || ruler.from) - ruler.from);
  const durationHtml = opts.showDuration
    ? `<span class="rp-avatar-duration">${reignYears} ${reignYears === 1 ? 'year' : 'years'}</span>`
    : '';
  return `
    <button class="rp-avatar${dimClass}" type="button" data-idx="${idx}" aria-label="${ruler.name}"${ringStyle}>
      <span class="rp-avatar-portrait">${rpPortraitInner(ruler)}</span>
      ${durationHtml}
      <span class="rp-avatar-info">
        <span class="rp-avatar-name">${ruler.name}</span>
        <span class="rp-avatar-years">${ruler.reign}</span>
        <span class="rp-avatar-dynasty"><span class="rp-avatar-dynasty-dot" style="background:${dynasty.color}"></span>${dynasty.label}</span>
      </span>
    </button>`;
}

// Computes a tidy [minYear, maxYear] window around exactly the given items
// (rounded to nearest 25 years, clamped to RP_AXIS_MIN, never narrower than
// 50 years) — used so the axis only ever spans what's actually on screen.
function rpWindowForItems(items) {
  const years = items.flatMap(r => [Math.max(r.from, RP_AXIS_MIN), r.to || r.from]);
  let minYear = Math.floor(Math.min(...years) / 25) * 25;
  let maxYear = Math.ceil(Math.max(...years) / 25) * 25;
  if (maxYear - minYear < 50) maxYear = minYear + 50;
  return [minYear, maxYear];
}

// Renders a paginated, chronological row of avatars (used by every tab).
// `direction` ('next' | 'prev' | null) controls whether the swap animates.
// `clickableLabels` is set by the All Rulers tab so its per-page dynasty
// labels can trigger the highlight view even though the axis itself stays
// sized to the current page.
function renderFlatAvatarRow(list, { direction = null, ringColor = null, clickableLabels = false } = {}) {
  dom.rpPagePrev.hidden = false;

  if (!list.length) {
    applyAvatarsHtml(`<p class="rp-section-desc">No rulers match your search.</p>`, direction);
    dom.rpPagePrev.disabled = true;
    dom.rpLegend.innerHTML = ''; dom.rpAxisTicks.innerHTML = '';
    dom.rpDynastyLabels.innerHTML = ''; dom.rpAxisBar.innerHTML = '';
    return;
  }

  const maxStart = Math.max(0, list.length - RP_PAGE_SIZE);
  rpState.pageStart = Math.max(0, Math.min(rpState.pageStart, maxStart));
  const start = rpState.pageStart;
  const pageItems = list.slice(start, start + RP_PAGE_SIZE);
  const hasNext = start + RP_PAGE_SIZE < list.length;
  if (clickableLabels) rpState.lastAllStart = start;

  // The per-page-sized axis applies to every tab — it only ever spans the
  // rulers actually on screen.
  const [minYear, maxYear] = rpWindowForItems(pageItems);
  // On All Rulers, the legend always lists every dynasty (a permanent
  // "jump to" menu) even though the axis/avatar row below only show the
  // current window. Other tabs — even ones with clickable labels, like
  // Grand Dukes or Joint Rulers — keep a legend scoped to just the
  // dynasties actually present on screen, not every dynasty site-wide.
  const legendIds = rpState.tab === 'all' || rpState.tab === 'by-reign-length'
    ? RP_DYNASTY_ORDER
    : RP_DYNASTY_ORDER.filter(id => pageItems.some(r => rulerDynasties(r).includes(id)));
  renderRpLegend(legendIds, { clickable: clickableLabels });
  renderRpAxisAndTrack(minYear, maxYear, pageItems, { clickable: clickableLabels });
  applyTimelineSlide(direction);

  const moreHtml = hasNext ? `
    <button class="rp-avatar-more" type="button" data-more="1" aria-label="Show more rulers">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M9 5L16 12L9 19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>` : '';

  const showDuration = rpState.tab === 'by-reign-length';
  applyAvatarsHtml(pageItems.map(r => rpAvatarHTML(r, { ringColor, showDuration })).join('') + moreHtml, direction);
  dom.rpPagePrev.disabled = rpState.pageStart === 0;
}

// Returns the start index (into `fullList`) of the centered window for a
// dynasty highlight, or null if that dynasty has no rulers in `fullList`.
// Used only to pick which page to jump to when a dynasty label is first
// clicked — after that, normal chronological paging takes over (see
// renderFlatAvatarRow / rpNextPage / rpPrevPage), so a dynasty with more
// rulers than fit on one page (e.g. Russian Imperial Administration) can
// still be paged through in full via the arrows.
function rpAllTabHighlightStart(fullList, dynastyId) {
  const matchIdxs = [];
  fullList.forEach((r, i) => { if (rulerDynasties(r).includes(dynastyId)) matchIdxs.push(i); });
  if (!matchIdxs.length) return null;
  // Center on the midpoint of the whole run (first..last match), not just
  // the middle match — for a short run this keeps every member on screen
  // instead of drifting toward one edge of the page.
  const rangeMid = (matchIdxs[0] + matchIdxs[matchIdxs.length - 1]) / 2;
  const start = Math.round(rangeMid - RP_PAGE_SIZE / 2);
  return Math.max(0, Math.min(start, Math.max(0, fullList.length - RP_PAGE_SIZE)));
}

// Slides the axis/track (`.rp-timeline`) into place after its content has
// already been re-rendered — used when a dynasty label click re-windows the
// axis, so the zoom reads as a slide rather than an instant snap. Unlike
// applyAvatarsHtml this has no "out" phase: the new window is already in the
// DOM, so it just enters from the direction of travel.
function applyTimelineSlide(direction) {
  const el = dom.rpTimeline;
  if (!direction || !el) return;
  const inClass = direction === 'next' ? 'rp-anim-in-right' : 'rp-anim-in-left';
  el.classList.add(inClass);
  void el.offsetWidth; // force reflow so the start position applies before animating
  requestAnimationFrame(() => el.classList.remove(inClass));
}

// Swaps `.rp-avatars`' content, sliding it out/in when `direction` is given.
function applyAvatarsHtml(html, direction) {
  const el = dom.rpAvatars;
  if (!direction) { el.innerHTML = html; return; }
  const outClass = direction === 'next' ? 'rp-anim-out-left' : 'rp-anim-out-right';
  const inClass  = direction === 'next' ? 'rp-anim-in-right' : 'rp-anim-in-left';
  el.classList.add(outClass);
  setTimeout(() => {
    el.innerHTML = html;
    el.classList.remove(outClass);
    el.classList.add(inClass);
    void el.offsetWidth; // force reflow so the "in" start position applies before animating
    requestAnimationFrame(() => el.classList.remove(inClass));
  }, 220);
}

// Shows the selected dynasty's name, reign span, and a short intro between
// the timeline and the avatar row — only on tabs with clickable dynasty
// labels (All Rulers, Grand Dukes, Joint Rulers), where a dynasty
// label/legend click highlights rather than filters the row.
function rpDynastyYearRange(id) {
  const members = RULERS.filter(r => rulerDynasties(r).includes(id));
  if (!members.length) return null;
  return {
    from: Math.min(...members.map(r => r.from)),
    to:   Math.max(...members.map(r => r.to || r.from)),
  };
}

function renderRpDynastyInfo() {
  const id = rpState.dynastyFilter;
  if (!id) { dom.rpDynastyInfo.hidden = true; return; }

  const d     = DYNASTIES[id];
  const range = rpDynastyYearRange(id);
  const years = range ? `${range.from === 0 ? '?' : range.from} &ndash; ${range.to}` : '';

  dom.rpDynastyInfo.innerHTML = `
    <div class="rp-dynasty-info-heading">
      <h2 class="rp-dynasty-info-name" style="color:${d.color}">${d.label}</h2>
      <span class="rp-dynasty-info-years">${years}</span>
    </div>
    <p class="rp-dynasty-info-desc">${d.description || ''}</p>
  `;
  dom.rpDynastyInfo.hidden = false;
}

// Dynasty labels/legend are clickable on these tabs. Chronological views
// highlight and center a dynasty; "By Reign Length" filters the ranking.
const RP_CLICKABLE_LABEL_TABS = ['all', 'grand-dukes', 'joint-rulers', 'by-reign-length'];

function renderRulerAvatars(direction = null) {
  hideRpTooltipImmediate();
  renderRpDynastyInfo();

  if (RP_CLICKABLE_LABEL_TABS.includes(rpState.tab)) {
    // Whether or not a dynasty filter is active, this renders the normal
    // paginated chronological row — rpAvatarHTML applies the highlight/dim
    // styling per item when a filter is set, so a dynasty with more rulers
    // than fit on one page can still be paged through via the arrows.
    renderFlatAvatarRow(getRpList(), { direction, clickableLabels: true });
    return;
  }

  renderFlatAvatarRow(getRpList(), { direction });
}

function setRpDynastyFilter(id) {
  const turningOn = rpState.dynastyFilter !== id;
  rpState.dynastyFilter = turningOn ? id : null;

  if (rpState.tab === 'by-reign-length') {
    rpState.pageStart = 0;
    renderRulerAvatars();
    return;
  }

  // Slide the timeline in the direction of travel, like the main app's
  // yearly timeline, instead of snapping straight to the new window. Uses
  // the current tab's own list (All Rulers, Grand Dukes, or Joint Rulers —
  // whichever has clickable dynasty labels active) so indices line up.
  let direction = null;
  const fullList = getRpList();
  const newStart = turningOn ? rpAllTabHighlightStart(fullList, id) : 0;
  // Jump straight to the centering index — no more snapping to a page
  // multiple, so short dynasty runs land fully on screen instead of
  // drifting toward one edge (or off it) of the row.
  rpState.pageStart = newStart === null ? 0 : newStart;
  if (newStart !== null && rpState.lastAllStart != null && newStart !== rpState.lastAllStart) {
    direction = newStart > rpState.lastAllStart ? 'next' : 'prev';
  }

  renderRulerAvatars(direction);
}

// Wraps setRpDynastyFilter for click handlers (legend swatch / timeline
// label) so the URL reflects whichever dynasty is now active — #early-dukes
// when toggled on, back to a bare /rulers when clicking the same one again
// turns it off (setRpDynastyFilter's own toggle behavior).
function setRpDynastyFilterAndSyncUrl(id) {
  setRpDynastyFilter(id);
  setLocationPath('/rulers', rpState.dynastyFilter ? dynastySlug(rpState.dynastyFilter) : '');
}

function rpNextPage() { rpState.pageStart += RP_PAGE_SIZE; renderRulerAvatars('next'); }
function rpPrevPage() { rpState.pageStart = Math.max(0, rpState.pageStart - RP_PAGE_SIZE); renderRulerAvatars('prev'); }

// Thickens the hovered ruler's own segment on the timeline and shows their
// reign's start/end year right above it, so a visitor can see exactly where
// in the timeline that reign falls.
function rpShowRulerHighlight(ruler) {
  // Always clear any previously-highlighted segment first — otherwise quick
  // hover movement across rulers (faster than the tooltip's hide delay) can
  // leave more than one segment thickened at once.
  rpHideRulerHighlight();

  if (rpState.axisMin == null) return;
  const idx = RULERS.indexOf(ruler);
  const tick = dom.rpRulerTicks.querySelector(`[data-idx="${idx}"]`);
  if (!tick) return;
  tick.classList.add('is-highlighted');
  const color = rpDynastyInfo(ruler).color;

  const span = Math.max(1, rpState.axisMax - rpState.axisMin);
  const startYear = Math.max(ruler.from, rpState.axisMin);
  const endYear   = Math.max(Math.min(ruler.to || ruler.from, rpState.axisMax), startYear);
  const startPct  = ((startYear - rpState.axisMin) / span) * 100;
  const endPct    = ((endYear - rpState.axisMin) / span) * 100;

  dom.rpHoverYearStart.textContent = ruler.from === 0 ? '?' : ruler.from;
  dom.rpHoverYearStart.style.left  = `${startPct}%`;
  dom.rpHoverYearStart.style.color = color;
  dom.rpHoverYearStart.classList.add('is-visible');

  dom.rpHoverYearEnd.textContent = ruler.to || ruler.from;
  dom.rpHoverYearEnd.style.left  = `${endPct}%`;
  dom.rpHoverYearEnd.style.color = color;
  dom.rpHoverYearEnd.classList.toggle('is-visible', endPct !== startPct);
}

function rpHideRulerHighlight() {
  dom.rpRulerTicks.querySelectorAll('.rp-ruler-tick.is-highlighted').forEach(el => el.classList.remove('is-highlighted'));
  dom.rpHoverYearStart.classList.remove('is-visible');
  dom.rpHoverYearEnd.classList.remove('is-visible');
}

// Cuts text to at most maxLen characters, breaking at the last whole word
// so the tooltip bio never grows tall enough to cover neighboring rulers.
function truncateText(text, maxLen) {
  if (!text || text.length <= maxLen) return text || '';
  const cut = text.slice(0, maxLen);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > 0 ? lastSpace : maxLen)}…`;
}

function showRpTooltip(ruler, anchorEl) {
  clearTimeout(rpTooltipHideTimer);
  rpShowRulerHighlight(ruler);
  const d = rpDynastyInfo(ruler);
  dom.rpTooltip.innerHTML = `
    <div class="rp-detail-body">
      <h3 class="rp-detail-name">${ruler.name}</h3>
      <p class="rp-detail-meta">${ruler.reign} &middot; ${d.label}</p>
      <p class="rp-detail-bio">${truncateText(ruler.bio, 200)}</p>
      <button type="button" class="rp-detail-profile-link" id="rp-profile-link">View full profile &rarr;</button>
    </div>`;
  document.getElementById('rp-profile-link').addEventListener('click', () => openRulerProfileModal(ruler));
  dom.rpTooltip.dataset.rulerIdx = String(RULERS.indexOf(ruler));
  dom.rpTooltip.hidden = false;

  const rowRect      = dom.rpAvatars.parentElement.getBoundingClientRect();
  const anchorRect   = anchorEl.getBoundingClientRect();
  const gap          = 14;
  const tooltipWidth = 360;
  const tooltipHeight = dom.rpTooltip.offsetHeight;

  let flipped = false;
  let left = (anchorRect.right - rowRect.left) + gap;
  if (left + tooltipWidth > rowRect.width) {
    // Not enough room to the right — show it to the left of the avatar instead.
    left = (anchorRect.left - rowRect.left) - gap - tooltipWidth;
    flipped = true;
  }
  left = Math.max(4, left);

  // Centre the tooltip on the anchor's vertical midpoint, then clamp so it
  // never runs off the top/bottom of the viewport (it used to only offset
  // 30px above the anchor, which pushed tall tooltips below the fold).
  const anchorCenterY = anchorRect.top + anchorRect.height / 2;
  const viewportMargin = 12;
  const idealViewportTop = anchorCenterY - tooltipHeight / 2;
  const maxViewportTop   = window.innerHeight - tooltipHeight - viewportMargin;
  const clampedViewportTop = Math.max(viewportMargin, Math.min(idealViewportTop, maxViewportTop));
  const top = clampedViewportTop - rowRect.top;

  // Point the little arrow at the anchor's centre, wherever the tooltip
  // itself landed after clamping.
  const arrowTop = Math.max(20, Math.min(anchorCenterY - clampedViewportTop, tooltipHeight - 20));

  dom.rpTooltip.style.left = `${left}px`;
  dom.rpTooltip.style.top  = `${top}px`;
  dom.rpTooltip.style.setProperty('--rp-arrow-top', `${arrowTop}px`);
  dom.rpTooltip.classList.toggle('is-flipped', flipped);

  requestAnimationFrame(() => dom.rpTooltip.classList.add('is-visible'));
}

function hideRpTooltip() {
  dom.rpTooltip.classList.remove('is-visible');
  delete dom.rpTooltip.dataset.rulerIdx;
  rpHideRulerHighlight();
}

function hideRpTooltipImmediate() {
  clearTimeout(rpTooltipHideTimer);
  dom.rpTooltip.classList.remove('is-visible');
  dom.rpTooltip.innerHTML = '';
  delete dom.rpTooltip.dataset.rulerIdx;
  rpHideRulerHighlight();
}

function scheduleHideRpTooltip() {
  clearTimeout(rpTooltipHideTimer);
  rpTooltipHideTimer = setTimeout(hideRpTooltip, 150);
}

// Adjacent ruler in the RULERS timeline — used for the Predecessor/Successor
// row. The array is already chronological, so this is plain index adjacency,
// not a stored relationship (avoids duplicating data that can go stale).
function getAdjacentRuler(ruler, dir) {
  const idx = RULERS.indexOf(ruler);
  return RULERS[idx + dir] || null;
}

// Gendered icons for family-tree nodes whose role implies a known gender
// (father = male, mother/wife = female) — a head-circle plus either
// squared shoulders (male) or a flared dress silhouette (female). Children
// aren't gendered this way since rulers.json has no per-child gender field.
const RP_MALE_ICON = `<svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><circle cx="12" cy="7.5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5.5 20v-3c0-2.8 2.9-4.7 6.5-4.7s6.5 1.9 6.5 4.7v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const RP_FEMALE_ICON = `<svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><circle cx="12" cy="7.5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9.6 12.2L5.5 20h13l-4.1-7.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// Pulls the first 3-4 digit year out of a born/died value, which may be a
// plain number, an approximate "c. YYYY" string, or an "alive" sentinel.
function rpParseYear(val) {
  if (val == null) return null;
  const m = String(val).match(/\d{3,4}/);
  return m ? Number(m[0]) : null;
}

// "born – died (aged N)" (escaped), built from ruler.born/ruler.died (each a
// year, an approximate "c. YYYY" string, or omitted where genuinely
// unknown). ruler.died === 'alive' covers living rulers, whose current age
// is computed the same way Wikipedia infoboxes do. Returns '' when neither
// is known.
function rpBornDiedLine(ruler) {
  if (!ruler.born && !ruler.died) return '';

  const bornYear = rpParseYear(ruler.born);
  const endYear = ruler.died === 'alive' ? new Date().getFullYear() : rpParseYear(ruler.died);
  let ageSuffix = '';
  if (bornYear != null && endYear != null && endYear >= bornYear) {
    const isApprox = /c\.|circa/i.test(String(ruler.born)) || /c\.|circa/i.test(String(ruler.died));
    const age = endYear - bornYear;
    const label = ruler.died === 'alive' ? 'age' : 'aged';
    ageSuffix = ` (${isApprox ? '~' : ''}${label} ${age})`;
  }

  const bornValue = String(ruler.born || 'Unknown');
  const diedValue = ruler.died === 'alive' ? 'Living' : String(ruler.died || 'Unknown');
  return escapeHtml(`${bornValue} – ${diedValue}${ageSuffix}`);
}

// Portrait caption (small badge over the photo in the modal) — falls back
// to the reign years for the handful of rulers with no recorded born/died
// (e.g. a prehistoric period).
function rpPortraitCaptionDates(ruler) {
  return rpBornDiedLine(ruler) || escapeHtml(ruler.reign);
}

// Richer caption shown under the full-size portrait lightbox — name, title,
// born/died (with age), and reign, since there's room to spell all of it out.
function rpFullPortraitCaptionHtml(ruler) {
  const bornDied = rpBornDiedLine(ruler);
  return `
    <span class="image-lightbox-caption-name">${escapeHtml(ruler.name)}</span>
    <span class="image-lightbox-caption-title">${escapeHtml(ruler.title)}</span>
    ${bornDied ? `<span class="image-lightbox-caption-dates">${bornDied}</span>` : ''}
    <span class="image-lightbox-caption-reign">Reign: ${escapeHtml(ruler.reign)}</span>`;
}
const RP_CROWN_ICON = `<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M3 18h18v2H3z" fill="currentColor"/><path d="M4 16L2.5 7l5 3.2L12 4l4.5 6.2 5-3.2L20 16H4z" fill="currentColor"/></svg>`;
const RP_PEOPLE_ICON = `<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="9" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="16.5" cy="9.2" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 20c1-3.6 3.7-5.6 6.5-5.6s5.5 2 6.5 5.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M15 20c.6-2.7 2.3-4.5 4.5-4.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;

// Builds the "Family" tree (parents / ruler / known children) shown beside
// the portrait. Only rulers researched down to the elective monarchs have
// `family` data in rulers.json — later dynasties simply omit the key and
// this section is skipped entirely.
function rpFamilyHtml(ruler) {
  const family = ruler.family;
  if (!family) return '';

  const parentNode = (label, name, icon) => `
    <div class="rp-family-node">
      <span class="rp-family-node-icon">${icon}</span>
      <span class="rp-family-node-text">
        <span class="rp-family-node-label">${label}</span>
        <span class="rp-family-node-name">${escapeHtml(name || 'Unknown')}</span>
      </span>
    </div>`;

  const wives = Array.isArray(family.wife) ? family.wife : (family.wife ? [family.wife] : []);
  const wifeHtml = wives.length ? `
      <div class="rp-family-stem"></div>
      <span class="rp-family-group-label">${wives.length > 1 ? 'Wives' : 'Wife'}</span>
      <div class="rp-family-row">
        ${wives.map(w => `
          <div class="rp-family-node">
            <span class="rp-family-node-icon">${RP_FEMALE_ICON}</span>
            <span class="rp-family-node-text">
              <span class="rp-family-node-name">${escapeHtml(w)}</span>
            </span>
          </div>`).join('')}
      </div>` : '';

  const children = Array.isArray(family.children) ? family.children : [];
  const childrenHtml = children.length ? `
      <div class="rp-family-stem"></div>
      <div class="rp-family-bar"></div>
      <span class="rp-family-group-label">Children (known)</span>
      <div class="rp-family-row">
        ${children.map(c => `
          <div class="rp-family-node">
            <span class="rp-family-node-text">
              <span class="rp-family-node-name">${escapeHtml(c.name)}</span>
              ${c.note ? `<span class="rp-family-node-years">${escapeHtml(c.note)}</span>` : ''}
            </span>
          </div>`).join('')}
      </div>
      ${family.childrenNote ? `<p class="rp-family-note">${escapeHtml(family.childrenNote)}</p>` : ''}` : '';

  return `
    <div class="rp-family">
      <div class="rp-family-heading">
        <h3 class="rp-family-main-title">Family Tree</h3>
        <div class="rp-family-fancy-divider" aria-hidden="true"><span class="rp-family-fancy-divider-dot"></span></div>
      </div>
      <span class="rp-family-group-label">Parents</span>
      <div class="rp-family-row">
        ${parentNode('Father', family.father, RP_MALE_ICON)}
        ${parentNode('Mother', family.mother, RP_FEMALE_ICON)}
      </div>
      <div class="rp-family-bar rp-family-bar--bottom"></div>
      <div class="rp-family-stem"></div>
      <div class="rp-family-self">
        <div class="rp-family-self-box">
          ${RP_CROWN_ICON}
          <span class="rp-family-self-name">${escapeHtml(ruler.name)}</span>
          <span class="rp-family-self-years">${escapeHtml(ruler.reign)}</span>
        </div>
      </div>
      ${wifeHtml}
      ${childrenHtml}
    </div>`;
}

// Compact "Family Tree" card shown in the media column — parents/wife/
// children reduced to a glance summary, with a button that opens the full
// tree (rpFamilyHtml above) in a separate lightbox, since the full tree is
// too tall to sit permanently between the portrait and predecessor/
// successor strip.
function rpFamilySummaryHtml(ruler) {
  const family = ruler.family;
  if (!family) return '';

  const wives = Array.isArray(family.wife) ? family.wife : (family.wife ? [family.wife] : []);
  const children = Array.isArray(family.children) ? family.children : [];
  const wifeLabel = wives.length > 1 ? 'Wives' : 'Wife';
  const totalMembers = 2 + Math.max(wives.length, 1) + children.length;

  const person = (name, icon) => `
    <div class="rp-family-summary-person">
      <span class="rp-family-summary-avatar">${icon}</span>
      <span class="rp-family-summary-name">${escapeHtml(name || 'Unknown')}</span>
    </div>`;

  const childrenGroup = children.length ? `
    <span class="rp-family-summary-divider" aria-hidden="true"></span>
    <div class="rp-family-summary-group">
      <span class="rp-family-summary-label">Children</span>
      <div class="rp-family-summary-people">
        <div class="rp-family-summary-person rp-family-summary-person--count">
          <span class="rp-family-summary-avatar rp-family-summary-avatar--count">${RP_PEOPLE_ICON}</span>
          <span class="rp-family-summary-count">${children.length}</span>
        </div>
      </div>
    </div>` : '';

  return `
    <div class="rp-family-summary">
      <div class="rp-family-summary-heading">
        <span class="rp-family-summary-line" aria-hidden="true"></span>
        <h3 class="rp-family-summary-title">Family Tree</h3>
        <span class="rp-family-summary-line" aria-hidden="true"></span>
      </div>
      <div class="rp-family-summary-groups">
        <div class="rp-family-summary-group">
          <span class="rp-family-summary-label">Parents</span>
          <div class="rp-family-summary-people">
            ${person(family.father, RP_MALE_ICON)}
            ${person(family.mother, RP_FEMALE_ICON)}
          </div>
        </div>
        <span class="rp-family-summary-divider" aria-hidden="true"></span>
        <div class="rp-family-summary-group">
          <span class="rp-family-summary-label">${wifeLabel}</span>
          <div class="rp-family-summary-people">
            ${person(wives[0], RP_FEMALE_ICON)}
          </div>
        </div>
        ${childrenGroup}
      </div>
      <button type="button" class="rp-family-summary-btn">
        <span class="rp-family-summary-btn-main">
          <span class="rp-family-summary-btn-icon">${RP_PEOPLE_ICON}</span>
          <span>View family tree</span>
        </span>
        <svg class="rp-family-summary-btn-arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p class="rp-family-summary-hint">Click to expand &bull; ${totalMembers} family members</p>
    </div>`;
}

// Rulers without genealogy data (elective monarchs onward — see
// .rp-modal-grid's default comment) get this events column instead of a
// family tree: every timeline event that falls within their reign's
// from/to years, reusing the same era/event data the timeline itself uses.
function rpEventsForRuler(ruler) {
  if (ruler.from == null) return [];
  return rpEventsInRanges([[ruler.from, ruler.to ?? ruler.from]]);
}

// Timeline events whose year falls inside any of the [from, to] ranges
// (a ruler's reign, or each of a prime minister's terms).
function rpEventsInRanges(ranges) {
  const items = [];
  state.eras.forEach((era, eraIdx) => {
    if (era.isIntro || era.year == null) return;
    if (!ranges.some(([from, to]) => era.year >= from && era.year <= to)) return;
    era.events.forEach((event, eventIndex) => {
      items.push({ eraIdx, eventIndex, year: era.year, event });
    });
  });
  return items;
}

function rpEventsHtml(ruler, { items = rpEventsForRuler(ruler), heading = 'Events During Reign', empty = 'No recorded events during this reign.' } = {}) {

  // Consecutive events in the same year only show the year once, on the
  // first of the group — repeating it for every title read as noisy.
  let lastYear = null;
  const rows = items.map(({ eraIdx, eventIndex, year, event }) => {
    const showYear = year !== lastYear;
    lastYear = year;
    return `
          <div class="rp-events-item${showYear ? '' : ' rp-events-item--grouped'}" data-era-idx="${eraIdx}" data-event-index="${eventIndex}" role="button" tabindex="0">
            <span class="rp-events-year">${showYear ? year : ''}</span>
            <div class="rp-events-text">
              <span class="rp-events-title">${escapeHtml(event.title)}</span>
            </div>
          </div>`;
  }).join('');

  // The column stays put even for sparsely-documented rulers (e.g.
  // Butvydas) rather than disappearing — a "none recorded" note is more
  // honest than silently dropping the whole section.
  const body = items.length
    ? `<div class="rp-events-list">${rows}</div>`
    : `<p class="rp-events-empty">${empty}</p>`;

  return `
    <div class="rp-events">
      <div class="em-world-heading"><span>${heading}</span></div>
      ${body}
    </div>`;
}

// Single floating tooltip reused for every "Events During Reign" title —
// created lazily on first use rather than living in index.html since it's
// only ever needed inside the ruler profile modal.
let rpEventTooltipEl = null;
function getRpEventTooltipEl() {
  if (!rpEventTooltipEl) {
    rpEventTooltipEl = document.createElement('div');
    rpEventTooltipEl.className = 'rp-event-tooltip';
    rpEventTooltipEl.setAttribute('role', 'tooltip');
    document.body.appendChild(rpEventTooltipEl);
  }
  return rpEventTooltipEl;
}

function showRpEventTooltip(text, anchorEl) {
  if (!text) return;
  const el = getRpEventTooltipEl();
  el.textContent = text;
  el.classList.add('is-visible');

  const anchorRect = anchorEl.getBoundingClientRect();
  const gap = 10;
  const width = el.offsetWidth;
  const height = el.offsetHeight;

  const left = Math.min(Math.max(12, anchorRect.left), window.innerWidth - width - 12);
  let top = anchorRect.top - height - gap;
  if (top < 12) top = anchorRect.bottom + gap;

  el.style.left = `${left}px`;
  el.style.top = `${top}px`;
}

function hideRpEventTooltip() {
  if (rpEventTooltipEl) rpEventTooltipEl.classList.remove('is-visible');
}

function rpPredSuccHtml(ruler) {
  const prev = getAdjacentRuler(ruler, -1);
  const next = getAdjacentRuler(ruler, 1);
  // Prehistoric Britain is a period, not an individual predecessor.
  const prevIsPlaceholder = prev && prev.reignLabel === 'Period';
  const col = (label, r) => `
    <div class="rp-predsucc-col${r ? ' is-clickable' : ''}"${r ? ` data-ruler-idx="${RULERS.indexOf(r)}" role="button" tabindex="0"` : ''}>
      <span class="rp-predsucc-label">${label}</span>
      <span class="rp-predsucc-name">${r ? escapeHtml(r.name) : (label === 'Successor' ? 'Incumbent' : 'First recorded ruler')}</span>
      ${r ? `<span class="rp-predsucc-years">${escapeHtml(r.reign)}</span>` : ''}
    </div>`;

  return `
    <div class="rp-succession">
      <div class="em-power-heading"><span>Succession Line</span></div>
      <div class="rp-predsucc">
        ${col('Predecessor', prevIsPlaceholder ? null : prev)}
        <span class="rp-predsucc-divider" aria-hidden="true"></span>
        ${col('Successor', next)}
      </div>
    </div>`;
}

function openRulerProfileModal(ruler) {
  // Every path that opens a ruler profile (avatar click, predecessor/
  // successor link, "who was in power" card, direct URL) funnels through
  // here, so updating the URL in this one place gives every one of them a
  // real, shareable /rulers/{slug} address for free.
  const slug = rulerSlug(ruler);
  if (slug) setLocationPath('/rulers/' + slug);

  const d = rpDynastyInfo(ruler);
  state.modalEvent = null;
  state.modalRuler = ruler;
  state.modalPm = null;
  state.modalReturnRuler = null;
  dom.modalYearTag.textContent = '';
  dom.modalTitle.textContent   = ruler.name;
  dom.modal.classList.remove('em-modal', 'map-modal', 'bibliography-modal', 'author-modal', 'legacy-modal');
  dom.modal.classList.add('rp-profile-modal');
  updateModalNavigation();

  // Always rendered, even without a Wikipedia link — every ruler modal
  // needs a way to report a mistake, not just the ones with sources.
  const sourceLinksHtml = ruler.wikipedia ? `
      <div class="modal-source-links">
        <span class="modal-source-label"><span class="em-source-icon">${EM_ICON_BOOK}</span>Sources &amp; further reading</span>
        <div class="modal-source-list">
          <a href="${ruler.wikipedia}" target="_blank" rel="noopener noreferrer">Wikipedia <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>` : '';
  const sourceLink = `
    <div class="modal-source">${sourceLinksHtml}
      <button type="button" class="modal-mistake-btn">
        <svg class="modal-mistake-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"/><line x1="8" y1="4.8" x2="8" y2="8.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="8" cy="11" r="0.9" fill="currentColor"/></svg>
        Noticed a mistake or have suggestions?
      </button>
    </div>`;

  const accomplishments = Array.isArray(ruler.accomplishments) && ruler.accomplishments.length ? `
    <div class="em-power-heading"><span>Main Accomplishments</span></div>
    <ul class="rp-accomplishments">
      ${ruler.accomplishments.map(a => `<li>${escapeHtml(a)}</li>`).join('')}
    </ul>` : '';

  const hasFamily = Boolean(ruler.family);
  // The events column (whatever happened during the reign, or a note that
  // none are recorded) always occupies the third column now; the family
  // tree, when researched, is a compact summary card in the media column
  // below the portrait — the full tree (rpFamilyHtml) opens in its own
  // lightbox on demand, since it's too tall to sit permanently there
  // alongside the portrait.
  const familySummaryHtml = hasFamily ? rpFamilySummaryHtml(ruler) : '';
  const eventsHtml = rpEventsHtml(ruler);

  dom.modalBody.innerHTML = `
    <div class="rp-modal-grid has-family">
      <div class="rp-modal-left">
        <span class="rp-modal-tag"><span class="rp-modal-tag-label">Reign:</span> ${escapeHtml(ruler.reign)} <span class="rp-modal-tag-sep" aria-hidden="true">&#10022;</span> ${escapeHtml(d.label)}</span>
        <p class="rp-modal-title-line">${escapeHtml(ruler.title)}</p>
        <div class="modal-divider"></div>
        <p class="rp-modal-bio">${escapeHtml(ruler.bio || '')}</p>
        ${accomplishments}
        ${rpPredSuccHtml(ruler)}
      </div>
      <div class="rp-modal-media">
        <div class="rp-modal-portrait${ruler.image ? ' is-zoomable' : ''}" ${ruler.image ? 'role="button" tabindex="0" aria-label="Expand portrait"' : ''}>
          ${rpPortraitInner(ruler)}
          <div class="rp-modal-portrait-caption">
            <span class="rp-modal-portrait-name">${escapeHtml(ruler.name)}</span>
            <span class="rp-modal-portrait-years">${rpPortraitCaptionDates(ruler)}</span>
          </div>
          ${ruler.image ? `<span class="rp-modal-portrait-zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>` : ''}
        </div>
        ${ruler.image && ruler.wikipedia ? `<a class="rp-modal-portrait-attribution" href="${ruler.wikipedia}" target="_blank" rel="noopener noreferrer">Portrait via Wikipedia</a>` : ''}
        ${familySummaryHtml}
      </div>
      <div class="rp-modal-right">${eventsHtml}</div>
    </div>
    ${sourceLink}`;

  const mistakeBtn = dom.modalBody.querySelector('.modal-mistake-btn');
  if (mistakeBtn) mistakeBtn.addEventListener('click', openContactModal);

  const familyTreeBtn = dom.modalBody.querySelector('.rp-family-summary-btn');
  if (familyTreeBtn) familyTreeBtn.addEventListener('click', () => openFamilyTreeLightbox(ruler, familyTreeBtn));

  // Opening an event from here should fade it in over this ruler's modal
  // and, on close, fade back into this same profile rather than dropping
  // all the way back to the timeline.
  bindRpEventsList(() => { state.modalReturnRuler = ruler; });

  if (ruler.image) {
    const portraitEl = dom.modalBody.querySelector('.rp-modal-portrait');
    const openPortraitLightbox = () => openImageLightbox({
      src: ruler.image,
      alt: `Portrait of ${ruler.name}`,
      captionHtml: rpFullPortraitCaptionHtml(ruler),
    }, portraitEl);
    portraitEl.addEventListener('click', openPortraitLightbox);
    portraitEl.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPortraitLightbox(); }
    });
  }

  dom.modalBody.querySelectorAll('.rp-predsucc-col[data-ruler-idx]').forEach(col => {
    const open = () => fadeSwapModal(() => openRulerProfileModal(RULERS[Number(col.dataset.rulerIdx)]));
    col.addEventListener('click', open);
    col.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });
  });

  dom.modal.hidden = false;
  document.body.style.overflow = 'hidden';
  requestAnimationFrame(() => requestAnimationFrame(() => {
    dom.modalPanel.classList.add('is-open');
  }));
}

// Click/keyboard/tooltip wiring for an "Events During Reign"-style list in
// the open profile modal; setReturn records where closing the event lands.
function bindRpEventsList(setReturn) {
  dom.modalBody.querySelectorAll('.rp-events-item').forEach(el => {
    const era = state.eras[Number(el.dataset.eraIdx)];
    const event = era && era.events[Number(el.dataset.eventIndex)];
    const open = () => {
      if (!era) return;
      // The hover tooltip has no reason to linger once its title has been
      // clicked and the event modal is on its way in.
      hideRpEventTooltip();
      setReturn();
      fadeSwapModal(() => openModal(era, Number(el.dataset.eventIndex)));
    };
    el.addEventListener('click', open);
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });

    const titleEl = el.querySelector('.rp-events-title');
    if (titleEl && event && event.text) {
      titleEl.addEventListener('mouseenter', () => showRpEventTooltip(event.text, titleEl));
      titleEl.addEventListener('mouseleave', hideRpEventTooltip);
      titleEl.addEventListener('focus', () => showRpEventTooltip(event.text, titleEl));
      titleEl.addEventListener('blur', hideRpEventTooltip);
    }
  });
}

/* ─────────────────────────────────────────
   PRIME MINISTER PROFILE — same three-column template as the ruler
   profile, filled from the #pm-data JSON that
   includes/prime-ministers-view.php embeds in the Prime Ministers page.
───────────────────────────────────────── */
let pmDataCache = null;
function pmData() {
  const el = document.getElementById('pm-data');
  if (!el) return null;
  if (!pmDataCache || pmDataCache.el !== el) pmDataCache = { el, data: JSON.parse(el.textContent) };
  return pmDataCache.data;
}

function pmById(id) {
  const data = pmData();
  return data ? data.pms.find(pm => pm.id === id) || null : null;
}

function getAdjacentPm(pm, dir) {
  const pms = pmData().pms;
  return pms[pms.indexOf(pm) + dir] || null;
}

function pmInOffice(pm) {
  const first = pm.terms[0], last = pm.terms[pm.terms.length - 1];
  if (last.endYear === null) return `${first.startYear} – present`;
  return first.startYear === last.endYear ? String(first.startYear) : `${first.startYear} – ${last.endYear}`;
}

function openPmProfileModal(id) {
  const pm = pmById(id);
  if (!pm) return;
  setLocationPath('/rulers/prime-ministers/' + pm.id);

  const data = pmData();
  const parties = pm.partyIds.map(p => data.partyLabels[p]).join(' / ');
  const inOffice = pmInOffice(pm);
  state.modalEvent = null;
  state.modalRuler = null;
  state.modalPm = pm;
  state.modalReturnPm = null;
  dom.modalYearTag.textContent = '';
  dom.modalTitle.textContent   = pm.name;
  dom.modal.classList.remove('em-modal', 'map-modal', 'bibliography-modal', 'author-modal', 'legacy-modal');
  dom.modal.classList.add('rp-profile-modal');
  updateModalNavigation();

  const facts = [
    ['Party', parties],
