───────────────────────────────────────── */
const SUBPAGES = {
  'prime-ministers': { id: 'pm-page',     path: 'rulers/prime-ministers' },
  houses:            { id: 'houses-page', path: 'houses' },
};
let activeSubpage = null;

function subpageEl(key) { return document.getElementById(SUBPAGES[key].id); }

async function openSubpage(key, path) {
  const page = subpageEl(key);
  if (!page) return;
  const panel = page.querySelector('.rp-panel');
  closeSubpages(key);
  activeSubpage = key;
  page.hidden = false;
  document.body.classList.add('subpage-open');
  requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('is-open')));

  if (panel.dataset.loaded !== path) {
    panel.dataset.loaded = path;
    try {
      const res = await fetch(BASE_PATH + '/' + path + '?partial=1', { headers: { Accept: 'text/html' } });
      const html = await res.text();
      if (panel.dataset.loaded !== path) return; // superseded by a newer navigation
      panel.innerHTML = html;
      page.scrollTop = 0;
    } catch {
      delete panel.dataset.loaded;
      panel.innerHTML = '<p class="rp-section-desc">This page could not be loaded. Please try again.</p>';
      return;
    }
  }
  if (panel.dataset.inited !== path) {
    panel.dataset.inited = path;
    if (window.SubpageInit && window.SubpageInit[key]) window.SubpageInit[key](panel);
  }
}

function closeSubpage(key) {
  const page = subpageEl(key);
  if (!page || page.hidden) return;
  const panel = page.querySelector('.rp-panel');
  panel.classList.remove('is-open');
  const finish = () => {
    if (panel.classList.contains('is-open')) return; // reopened in the meantime
    page.hidden = true;
    if (Object.keys(SUBPAGES).every(k => subpageEl(k).hidden)) document.body.classList.remove('subpage-open');
  };
  panel.addEventListener('transitionend', finish, { once: true });
  setTimeout(finish, 600);
  if (activeSubpage === key) activeSubpage = null;
}

function closeSubpages(except = null) {
  Object.keys(SUBPAGES).forEach(k => { if (k !== except) closeSubpage(k); });
}

function subpageOpen() {
  return Object.keys(SUBPAGES).some(k => { const el = subpageEl(k); return el && !el.hidden; });
}

// Same-origin links inside the subpages (and the Rulers page's tab switcher)
// that point at another in-app route navigate without a full reload.
function isSpaPath(path) {
  const parts = path.replace(/^\/+|\/+$/g, '').split('/');
  if (parts.length === 1) return ['timeline', 'rulers', 'houses', 'at-glance', 'map', 'legacy', 'bibliography', 'about'].includes(parts[0]);
  if (parts.length === 2 && parts[0] === 'houses') return true;
  if (parts.length === 2 && parts[0] === 'rulers') return parts[1] === 'prime-ministers' || rulerIndexBySlug.has(parts[1]);
  if (parts.length === 3 && parts[0] === 'rulers' && parts[1] === 'prime-ministers') return true;
  return false;
}

function bindSubpageEvents() {
  document.addEventListener('click', e => {
    if (e.defaultPrevented) return;
    const close = e.target.closest('.subpage-close');
    if (close) {
      closeSubpages();
      setActiveNavLink('overview');
      setLocationPath('/timeline');
      return;
    }
    const link = e.target.closest('.subpage-page a[href], .rulers-subnav a[href]');
    if (!link || link.target === '_blank' || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin || (url.hash && url.pathname === window.location.pathname)) return;
    let path = url.pathname;
    if (BASE_PATH && path.indexOf(BASE_PATH) === 0) path = path.slice(BASE_PATH.length);
    if (!isSpaPath(path)) return;
    e.preventDefault();
    setLocationPath(path);
    routeFromPath();
    const scroller = link.closest('.rulers-page');
    if (scroller) scroller.scrollTop = 0;
  });
}

