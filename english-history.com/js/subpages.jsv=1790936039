'use strict';
/* Behaviour for the Noble Houses and Prime Ministers overlay pages. main.js
 * calls window.SubpageInit[key](panel) whenever that page's contents are
 * rendered inline or fetched; every init is idempotent per rendered panel. */
window.SubpageInit = (() => {
  const normalize = value => value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function houses(root) {
    // Profile section links scroll inside the overlay without touching history.
    root.querySelectorAll('.house-section-nav a[href^="#"]').forEach(link => link.addEventListener('click', event => {
      const target = root.querySelector(link.getAttribute('href'));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }));

    const filters = root.querySelector('.houses-filters');
    if (!filters) return;
    filters.hidden = false;
    const search = filters.querySelector('#house-search');
    const type = filters.querySelector('#house-type');
    const cards = [...root.querySelectorAll('.house-card')];
    const count = root.querySelector('#house-count');
    const empty = root.querySelector('#house-empty');
    function filterHouses() {
      const query = normalize(search.value.trim());
      let shown = 0;
      cards.forEach(card => {
        const category = card.dataset.houseType;
        const matchesType = !type.value || (type.value === 'royal' ? category !== 'noble-house' : category !== 'royal-dynasty');
        card.hidden = !(matchesType && normalize(card.dataset.search).includes(query));
        if (!card.hidden) shown++;
      });
      count.textContent = `${shown} ${shown === 1 ? 'house' : 'houses'}`;
      empty.hidden = shown > 0;
    }
    search.addEventListener('input', filterHouses);
    type.addEventListener('change', filterHouses);
    filters.addEventListener('reset', () => requestAnimationFrame(filterHouses));
  }

  function primeMinisters(root) {
    const controls = root.querySelector('.pm-controls');
    const grid = root.querySelector('#pm-avatars');
    if (!controls || !grid) return;

    const cards = [...grid.querySelectorAll('.pm-avatar')];
    const search = root.querySelector('#pm-search');
    const sort = root.querySelector('#pm-sort');
    const count = root.querySelector('#pm-count');
    const empty = root.querySelector('#pm-empty');
    const modeButtons = [...controls.querySelectorAll('.rp-tab')];
    const legendItems = [...root.querySelectorAll('.pm-legend-item')];

    const prev = root.querySelector('#pm-page-prev');
    const next = root.querySelector('#pm-page-next');
    const state = { mode: 'all', sort: 'chrono', party: null, query: '', start: 0, size: 12 };
    const comparators = {
      chrono: (a, b) => a.dataset.start - b.dataset.start,
      tenure: (a, b) => b.dataset.months - a.dataset.months || a.dataset.start - b.dataset.start,
      party: (a, b) => a.dataset.partyOrder - b.dataset.partyOrder || a.dataset.start - b.dataset.start,
      name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
    };

    // Two rows of cards; the column count adapts to the width, like the Monarchs page.
    function computeSize() {
      const width = grid.getBoundingClientRect().width;
      if (!width) return state.size;
      const gap = parseFloat(getComputedStyle(grid).columnGap) || 10.24;
      const minCard = width < 600 ? 120 : 130;
      const cols = Math.max(2, Math.min(8, Math.floor((width + gap) / (minCard + gap))));
      grid.style.setProperty('--rp-cols', cols);
      return cols * 2;
    }

    // ── Timeline: spans only the prime ministers currently on screen ──
    const data = JSON.parse(root.querySelector('#pm-data').textContent);
    const pmById = new Map(data.pms.map(pm => [pm.id, pm]));
    const trackMonarchs = root.querySelector('#pm-t-monarchs');
    const trackPms = root.querySelector('#pm-t-pms');
    const trackAxis = root.querySelector('#pm-t-axis');
    const esc = value => String(value).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function renderTimeline(shownCards) {
      const items = shownCards.map(card => pmById.get(card.dataset.id));
      if (!items.length) { trackMonarchs.innerHTML = trackPms.innerHTML = trackAxis.innerHTML = ''; return; }
      const terms = items.flatMap(pm => pm.terms);
      const min = Math.floor(Math.min(...terms.map(t => t.start)) / 25) * 25;
      let max = Math.ceil(Math.max(...terms.map(t => t.end)) / 25) * 25;
      if (max - min < 50) max = min + 50;
      const span = max - min;
      const pct = year => ((year - min) / span) * 100;

      const steps = [5, 10, 25, 50, 100];
      const step = steps.find(n => span / 8 <= n) || 100;
      const ticks = [];
      for (let y = Math.ceil(min / step) * step; y <= max; y += step) ticks.push(y);
      if (ticks[0] !== min) ticks.unshift(min);
      if (ticks[ticks.length - 1] !== max) ticks.push(max);
      trackAxis.innerHTML = ticks.map(y => `<span class="pm-tick${y % 50 === 0 ? ' is-major' : ''}" style="left:${pct(y)}%">${y}</span>`).join('');

      // Monarch context: same thin coloured line as the Monarchs timeline.
      const monarchs = data.monarchs.filter(m => m.to > min && m.from < max);
      const runs = [];
      monarchs.forEach(m => {
        const last = runs[runs.length - 1];
        const from = Math.max(m.from, min), to = Math.min(m.to, max);
        if (last && last.dynasty === m.dynasty) last.to = to; else runs.push({ dynasty: m.dynasty, color: m.color, from, to });
      });
      const trackWidth = trackMonarchs.clientWidth || 900;
      const labels = monarchs.map((m, i) => {
        const from = Math.max(m.from, min), to = Math.min(m.to, max);
        if ((to - from) / span * trackWidth < 46) return '';
        const cls = `rp-dynasty-label ${i % 2 === 0 ? 'rp-dynasty-label--top' : 'rp-dynasty-label--bottom'}`;
        const style = `left:${pct((from + to) / 2)}%;color:${m.color}`;
        const title = esc(`${m.name} ${m.years}`);
        return m.href ? `<a class="${cls} pm-monarch-name" href="${esc(m.href)}" style="${style}" title="${title}">${esc(m.name)}</a>`
          : `<span class="${cls}" style="${style}">${esc(m.name)}</span>`;
      }).join('');
      trackMonarchs.innerHTML = `<div class="rp-dynasty-labels">${labels}</div><div class="rp-axis-bar">`
        + runs.map(r => `<div class="rp-segment" style="left:${pct(r.from)}%;width:${pct(r.to) - pct(r.from)}%;background:${r.color}"></div>`).join('')
        + monarchs.filter(m => m.from > min && m.from < max).map(m => `<span class="rp-transition-dot" style="left:${pct(m.from)}%"></span>`).join('')
        + '</div>';

      // Prime ministers: one bar per term; names live in the hover title and the cards below.
      trackPms.innerHTML = items.flatMap(pm => pm.terms.map(t => {
        const years = `${t.startYear}${t.endYear === null ? ' – present' : t.endYear === t.startYear ? '' : ' – ' + t.endYear}`;
        const left = pct(t.start);
        return `<a class="pm-bar" href="#pm-${pm.id}" data-pm="${pm.id}" data-party="${t.party}" style="left:${left}%;width:${Math.max(pct(t.end) - left, 0.25)}%;background:${data.parties[t.party]}" title="${esc(pm.name + ' · ' + years)}"><span class="visually-hidden">${esc(pm.name)}</span></a>`;
      })).join('');
      applyPartyDim();
    }

    function applyPartyDim() {
      root.querySelectorAll('.pm-bar').forEach(bar => bar.classList.toggle('is-dim', !!state.party && bar.dataset.party !== state.party));
    }

    // ── Hover tooltip beside the card, like the Monarchs page ──
    const tooltip = root.querySelector('#pm-tooltip');
    const row = grid.parentElement;
    let hideTimer = null;
    function showTooltip(card) {
      clearTimeout(hideTimer);
      const d = card.dataset;
      tooltip.innerHTML = `<div class="rp-detail-body">
        <h3 class="rp-detail-name">${esc(d.full)}</h3>
        <p class="rp-detail-meta">${esc(d.years)} &middot; ${esc(d.partyLabel)}</p>
        <p class="rp-detail-bio">${esc(d.known)}</p>
        <p class="rp-detail-bio pm-tip-facts"><b>Served under</b> ${esc(d.served)}<br><b>In office</b> ${esc(d.office)}</p>
        <a class="rp-detail-profile-link" href="${esc(d.wiki)}" target="_blank" rel="noopener noreferrer">Read more &#8599;</a>
      </div>`;
      tooltip.hidden = false;
      const rowRect = row.getBoundingClientRect();
      const anchor = card.getBoundingClientRect();
      const gap = 14, width = 360, height = tooltip.offsetHeight;
      let left = anchor.right - rowRect.left + gap;
      let flipped = false;
      if (left + width > rowRect.width) { left = anchor.left - rowRect.left - gap - width; flipped = true; }
      left = Math.max(4, left);
      const centreY = anchor.top + anchor.height / 2;
      const viewportTop = Math.max(12, Math.min(centreY - height / 2, window.innerHeight - height - 12));
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${viewportTop - rowRect.top}px`;
      tooltip.style.setProperty('--rp-arrow-top', `${Math.max(20, Math.min(centreY - viewportTop, height - 20))}px`);
      tooltip.classList.toggle('is-flipped', flipped);
      requestAnimationFrame(() => tooltip.classList.add('is-visible'));
    }
    const hideTooltip = () => { hideTimer = setTimeout(() => tooltip.classList.remove('is-visible'), 150); };
    tooltip.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    tooltip.addEventListener('mouseleave', hideTooltip);
    // Clicking a card opens that prime minister's profile modal (main.js).
    const openProfile = card => {
      clearTimeout(hideTimer);
      tooltip.classList.remove('is-visible');
      if (window.openPmProfileModal) window.openPmProfileModal(card.dataset.id);
    };
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => showTooltip(card));
      card.addEventListener('mouseleave', hideTooltip);
      card.addEventListener('focus', () => showTooltip(card));
      card.addEventListener('blur', hideTooltip);
      card.addEventListener('click', () => openProfile(card));
      card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openProfile(card); }
      });
    });

    let list = [];
    function render() {
      const query = normalize(state.query.trim());
      list = [...cards].sort(comparators[state.sort]).filter(card => (state.mode !== 'multi' || Number(card.dataset.terms) > 1)
        && (!state.party || card.dataset.parties.split(' ').includes(state.party))
        && normalize(card.dataset.search).includes(query));
      const shown = list.length;
      state.start = Math.max(0, Math.min(state.start, Math.max(0, shown - state.size)));
      const visible = new Set(list.slice(state.start, state.start + state.size));
      cards.forEach(card => { card.hidden = !visible.has(card); });
      list.forEach(card => grid.insertBefore(card, next));
      prev.disabled = state.start === 0;
      next.hidden = state.start + state.size >= shown;
      count.textContent = `${shown} ${shown === 1 ? 'prime minister' : 'prime ministers'}`;
      empty.hidden = shown > 0;
      sort.value = state.sort;
      grid.classList.toggle('show-duration', state.sort === 'tenure');
      modeButtons.forEach(btn => {
        const mode = btn.dataset.mode;
        btn.classList.toggle('active', mode === 'multi' ? state.mode === 'multi'
          : state.mode !== 'multi' && (mode === 'all' ? state.sort === 'chrono' || state.sort === 'name' : mode === state.sort));
      });
      legendItems.forEach(item => {
        const on = item.dataset.party === state.party;
        item.setAttribute('aria-pressed', String(on));
        item.classList.toggle('is-active', on);
      });
      renderTimeline(list.slice(state.start, state.start + state.size));
    }

    // Any change of filter/sort/search returns to the first page.
    const reset = () => { state.start = 0; };
    prev.addEventListener('click', () => { state.start = Math.max(0, state.start - state.size); render(); });
    next.addEventListener('click', () => { state.start += state.size; render(); });
    new ResizeObserver(() => {
      const size = computeSize();
      if (size !== state.size) { state.size = size; render(); }
    }).observe(grid);

    modeButtons.forEach(btn => btn.addEventListener('click', () => {
      reset();
      const mode = btn.dataset.mode;
      if (mode === 'multi') state.mode = state.mode === 'multi' ? 'all' : 'multi';
      else { state.mode = 'all'; state.sort = mode === 'all' ? 'chrono' : mode; }
      render();
    }));
    sort.addEventListener('change', () => { reset(); state.sort = sort.value; render(); });
    search.addEventListener('input', () => { reset(); state.query = search.value; render(); });
    legendItems.forEach(item => {
      item.disabled = false;
      item.classList.add('is-clickable');
      item.addEventListener('click', () => { reset(); state.party = state.party === item.dataset.party ? null : item.dataset.party; render(); });
    });

    // Timeline bars and labels jump to the matching card, clearing any filter that hides it.
    root.querySelector('.pm-timeline').addEventListener('click', event => {
      const link = event.target.closest('a[data-pm]');
      if (!link) return;
      event.preventDefault();
      const card = grid.querySelector('#pm-' + link.dataset.pm);
      if (!card) return;
      if (!list.includes(card)) {
        Object.assign(state, { mode: 'all', party: null, query: '' });
        search.value = '';
        render();
      }
      state.start = Math.floor(list.indexOf(card) / state.size) * state.size;
      render();
      card.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      card.classList.add('is-flash');
      setTimeout(() => card.classList.remove('is-flash'), 1800);
    });

    // Hovering a card highlights its terms on the timeline.
    const setHot = (id, on) => root.querySelectorAll(`.pm-bar[data-pm="${id}"]`)
      .forEach(el => el.classList.toggle('is-hot', on));
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => setHot(card.dataset.id, true));
      card.addEventListener('mouseleave', () => setHot(card.dataset.id, false));
    });

    controls.hidden = false;
    state.size = computeSize();
    render();
  }

  return { houses, 'prime-ministers': primeMinisters };
})();
