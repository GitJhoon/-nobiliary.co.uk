/* ─────────────────────────────────────────
   BASIC SOURCE / DEVTOOLS DETERRENCE
   Purely a UX speed bump for casual visitors — none of this can actually
   stop a determined user (view-source, curl, disabling JS, undocked/mobile
   devtools, and browser extensions all bypass it trivially). Keep it
   non-destructive: never break the page for people who aren't trying to
   inspect it, and never freeze the tab (no debugger-loop tricks).
───────────────────────────────────────── */
(function () {
  // Right-click context menu (still lets text selection/copy work normally).
  document.addEventListener('contextmenu', e => e.preventDefault());

  // Common "view source" / "open devtools" shortcuts.
  document.addEventListener('keydown', e => {
    const key = e.key.toLowerCase();
    const blockCombo =
      key === 'f12' ||
      ((e.ctrlKey || e.metaKey) && e.shiftKey && ['i', 'j', 'c'].includes(key)) ||
      ((e.ctrlKey || e.metaKey) && key === 'u');
    if (blockCombo) e.preventDefault();
  });

  // Heuristic devtools-open banner: compares outer/inner window dimensions,
  // which only shifts noticeably when devtools is docked to a side of the
  // same window. Undocked or mobile-remote devtools won't trigger this —
  // it's a deterrent, not a real barrier. Skipped entirely on touch devices:
  // it provides no real protection there anyway (mobile devtools are always
  // "undocked" from this check's perspective), but the on-screen keyboard
  // shrinks innerHeight the same way a docked panel would, which used to
  // false-positive the overlay every time someone tapped a text field.
  const THRESHOLD = 160;
  const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
  let overlay = null;

  function showOverlay() {
    if (overlay) return;
    overlay = document.createElement('div');
    overlay.id = 'devtools-overlay';
    overlay.innerHTML = '<p>Please close developer tools to continue browsing.</p>';
    Object.assign(overlay.style, {
      position: 'fixed', inset: '0', zIndex: '99999',
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      textAlign: 'center', padding: '40px',
      background: '#05040a', color: '#c9a844',
      fontFamily: 'Georgia, serif', fontSize: '18px',
    });
    document.body.appendChild(overlay);
  }

  function hideOverlay() {
    if (!overlay) return;
    overlay.remove();
    overlay = null;
  }

  // Also skipped inside a frame (the event modal's embedded map, /map?embed=1):
  // innerWidth there is the frame's, so the check would always fire.
  if (!isTouchDevice && window.top === window) {
    setInterval(() => {
      const widthDiff  = window.outerWidth  - window.innerWidth;
      const heightDiff = window.outerHeight - window.innerHeight;
      const open = widthDiff > THRESHOLD || heightDiff > THRESHOLD;
      if (open) showOverlay(); else hideOverlay();
    }, 800);
  }
})();
